 }
+
+type discardTextWriter struct{ *mockWriter }
+
+func (w discardTextWriter) DiscardsOutput() bool { return true }
+
+type noFormatEvent struct{ *mockTLSDataEvent }
+
+func (e noFormatEvent) String() string    { panic("discarded event must not be formatted") }
+func (e noFormatEvent) StringHex() string { panic("discarded event must not be hex formatted") }
+func TestDiscardedTextSkipsFormatting(t *testing.T) {
+	for _, hex := range []bool{false, true} {
+		writer := discardTextWriter{newMockWriter()}
+		handler := NewTextHandler(writer, hex)
+		event := noFormatEvent{&mockTLSDataEvent{data: []byte("plaintext retained by typed publisher"), dataLen: 37}}
+		if err := handler.Handle(event); err != nil {
+			t.Fatal(err)
+		}
+		if writer.Len() != 0 {
+			t.Fatal("discard writer unexpectedly received text")
+		}
+		if err := handler.Close(); err != nil {
+			t.Fatal(err)
+		}
+		if err := handler.Handle(event); err == nil {
+			t.Fatal("closed discard handler accepted event")
+		}
+	}
+}
diff --git a/internal/output/writers/null_file_test.go b/internal/output/writers/null_file_test.go
new file mode 100644
--- /dev/null
+++ b/internal/output/writers/null_file_test.go
@@ -0,0 +1,27 @@
+package writers
+
+import (
+	"os"
+	"testing"
+)
+
+func TestNullFileFlushAndClose(t *testing.T) {
+	for _, size := range []int{0, 4096} {
+		writer, err := NewFileWriter(FileWriterConfig{Path: os.DevNull, BufferSize: size})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if _, err := writer.Write([]byte("discarded text")); err != nil {
+			t.Fatal(err)
+		}
+		if err := writer.Flush(); err != nil {
+			t.Fatal(err)
+		}
+		if err := writer.Close(); err != nil {
+			t.Fatal(err)
+		}
+		if err := writer.Close(); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
