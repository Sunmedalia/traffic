+func TestSequencedClientSheddingKeepsFastClientAndFlushesTail(t *testing.T) {
+	ctx := context.Background()
+	server := NewServer("127.0.0.1:0", io.Discard)
+	defer server.Close()
+	slow, fast := newQueueClient(server, 4), newQueueClient(server, 4)
+	for _, client := range []*Client{slow, fast} {
+		if err := server.hub.registerClient(ctx, client); err != nil {
+			t.Fatal(err)
+		}
+	}
+	publish := func(seq uint64) {
+		t.Helper()
+		if err := server.PublishEvent(ctx, domain.CapturedEventEnvelope{Sequence: seq, Payload: []byte("data")}); err != nil {
+			t.Fatalf("publisher failed on sequenced event %d: %v", seq, err)
+		}
+		if got := decodeEntry(t, receiveQueueMessage(fast)).GetEventPayload().GetSequence(); got != seq {
+			t.Fatalf("fast client: got sequence %d, want %d", got, seq)
+		}
+	}
+	for seq := uint64(1); seq <= 100; seq++ {
+		publish(seq)
+	}
+	for _, want := range []uint64{1, 2} {
+		if got := decodeEntry(t, receiveQueueMessage(slow)).GetEventPayload().GetSequence(); got != want {
+			t.Fatalf("slow accepted prefix: got %d, want %d", got, want)
+		}
+	}
+	publish(101)
+	for _, want := range []uint64{3, 4, 101} {
+		if got := decodeEntry(t, receiveQueueMessage(slow)).GetEventPayload().GetSequence(); got != want {
+			t.Fatalf("slow recovered prefix: got %d, want %d", got, want)
+		}
+	}
+
+	for seq := uint64(102); seq <= 106; seq++ {
+		publish(seq)
+	}
+	control := fmt.Sprintf("traffic-control-v1:drained:seq=%d,dropped=%d,perf_lost=0", server.LastSequence(), server.DroppedMessages())
+	if err := server.PublishLog(ctx, domain.OperationalLogRecord{Message: control}); err != nil {
+		t.Fatal(err)
+	}
+	if got := server.DroppedMessages(); got != 97 {
+		t.Fatalf("dropped=%d, want 97", got)
+	}
+	if got := decodeEntry(t, receiveQueueMessage(fast)).GetRunLog(); got != control {
+		t.Fatalf("fast final control: %q", got)
+	}
+	for want := uint64(102); want <= 105; want++ {
+		if got := decodeEntry(t, receiveQueueMessage(slow)).GetEventPayload().GetSequence(); got != want {
+			t.Fatalf("slow terminal queue: got %d, want %d", got, want)
+		}
+	}
+	if got := decodeEntry(t, receiveQueueMessage(slow)).GetRunLog(); got != control {
+		t.Fatalf("slow final control: %q", got)
+	}
+	if slow.pendingBytes.Load() != 0 || fast.pendingBytes.Load() != 0 || server.hub.queuedBytes.Load() != 0 {
+		t.Fatal("drained queues leaked byte reservations")
+	}
