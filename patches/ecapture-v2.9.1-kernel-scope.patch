@@ -0,0 +1,90 @@
+package openssl
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/cilium/ebpf"
+)
+
+type fakeScopeMap struct {
+	values map[uint32]uint64
+	fail   bool
+}
+
+func (m *fakeScopeMap) Put(key, value interface{}) error {
+	if m.fail {
+		return errors.New("injected map update failure")
+	}
+	if m.values == nil {
+		m.values = map[uint32]uint64{}
+	}
+	var v uint64
+	switch x := value.(type) {
+	case uint32:
+		v = uint64(x)
+	case uint64:
+		v = x
+	default:
+		panic("wrong map value type")
+	}
+	m.values[key.(uint32)] = v
+	return nil
+}
+func (m *fakeScopeMap) Delete(key interface{}) error {
+	k := key.(uint32)
+	if _, ok := m.values[k]; !ok {
+		return ebpf.ErrKeyNotExist
+	}
+	delete(m.values, k)
+	return nil
+}
+func TestTrafficScopeUpdatesIdentityAndRemovesRetiredTargets(t *testing.T) {
+	pids, ports := &fakeScopeMap{}, &fakeScopeMap{}
+	control := &fakeScopeMap{}
+	scope := &trafficScopeMaps{pids: pids, ports: ports, control: control}
+	if err := scope.apply(trafficScopeConfig{Version: 1, PIDs: []trafficScopePID{{42, 100}, {43, 200}}, Ports: []uint32{443, 8443}}); err != nil {
+		t.Fatal(err)
+	}
+	if err := scope.apply(trafficScopeConfig{Version: 1, PIDs: []trafficScopePID{{42, 300}}, Ports: []uint32{443}}); err != nil {
+		t.Fatal(err)
+	}
+	if pids.values[42] != 300 || len(pids.values) != 1 || ports.values[8443] != 0 || ports.values[443] != 1 {
+		t.Fatal("stale PID identity or port remained", pids.values, ports.values)
+	}
+	ports.fail = true
+	if err := scope.apply(trafficScopeConfig{Version: 1, PIDs: []trafficScopePID{{44, 400}}, Ports: []uint32{443}}); err == nil {
+		t.Fatal("map update failure was hidden")
+	}
+	if control.values[0] != 2 {
+		t.Fatal("failed map update did not enable deny-all mode", control.values)
+	}
+	if len(pids.values) != 0 {
+		t.Fatal("failed update left an active PID allowlist", pids.values)
+	}
+}
+func TestTrafficScopeRejectsMalformedConfiguration(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "scope.json")
+	for _, data := range []string{
+		`{}`, `{"schema_version":2,"ports":[443]}`, `{"schema_version":1,"ports":[0]}`,
+		`{"schema_version":1,"ports":[65536]}`, `{"schema_version":1,"ports":[443,443]}`,
+		`{"schema_version":1,"ports":[443],"pids":[{"pid":42,"start_ticks":0}]}`,
+		`{"schema_version":1,"ports":[443],"pids":[{"pid":42,"start_ticks":1},{"pid":42,"start_ticks":2}]}`,
+		`{"schema_version":1,"ports":[443]} {}`, `{"schema_version":1,"ports":[443],"extra":1}`,
+	} {
+		if err := os.WriteFile(path, []byte(data), 0600); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := readTrafficScope(path); err == nil {
+			t.Fatal("invalid scope accepted", data)
+		}
+	}
+	if err := os.WriteFile(path, []byte(`{"schema_version":1,"ports":[443],"pids":[]}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := readTrafficScope(path); err != nil {
+		t.Fatal("empty PID scope must be a valid deny-all update", err)
+	}
+}
