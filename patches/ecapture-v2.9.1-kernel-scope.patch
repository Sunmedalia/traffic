diff --git a/docs/agent/probe-development.md b/docs/agent/probe-development.md
--- a/docs/agent/probe-development.md
+++ b/docs/agent/probe-development.md
@@ -252,3 +252,13 @@
 Connection metadata precedes payload; perf alignment padding is accepted.
 The Go decoder continues accepting the legacy fixed-array record. Rebuild
 bytecode and userspace together when enabling compact emission.
+
+The traffic scope opt-in (`--traffic-scope-file`) requires CO-RE and task BTF
+start_boottime/group_leader. It compares host TGID and the group leader start
+time in Linux USER_HZ ticks before OpenSSL event work; known endpoints are port
+filtered before plaintext copy. The bounded JSON snapshot is applied before
+attachment and watched for atomic replacements. Invalid updates clear the PID
+allowlist and publish a scope-error control record. Scope is disabled by default.
+The six previously reserved identity_pad bytes carry the low 48 bits of process
+start ticks; nonzero values prefix StreamID with PID:start_ticks/ without
+changing the compact record header size or legacy decoding.
diff --git a/internal/probe/openssl/traffic_scope.go b/internal/probe/openssl/traffic_scope.go
new file mode 100644
--- /dev/null
+++ b/internal/probe/openssl/traffic_scope.go
@@ -0,0 +1,231 @@
+package openssl
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"time"
+
+	"github.com/cilium/ebpf"
+	"github.com/cilium/ebpf/btf"
+	"github.com/gojue/ecapture/v2/internal/domain"
+)
+
+type trafficScopePID struct {
+	PID        uint32 `json:"pid"`
+	StartTicks uint64 `json:"start_ticks"`
+}
+type trafficScopeConfig struct {
+	Version  int               `json:"schema_version"`
+	Revision uint64            `json:"revision,omitempty"`
+	PIDs     []trafficScopePID `json:"pids"`
+	Ports    []uint32          `json:"ports"`
+}
+type trafficScopeMap interface {
+	Put(interface{}, interface{}) error
+	Delete(interface{}) error
+}
+type trafficScopeMaps struct {
+	pids, ports trafficScopeMap
+	control     trafficScopeMap
+	current     trafficScopeConfig
+}
+
+func readTrafficScope(path string) (trafficScopeConfig, error) {
+	var cfg trafficScopeConfig
+	f, err := os.Open(path)
+	if err != nil {
+		return cfg, err
+	}
+	defer f.Close()
+	info, err := f.Stat()
+	if err != nil {
+		return cfg, err
+	}
+	if !info.Mode().IsRegular() || info.Size() > 256<<10 {
+		return cfg, fmt.Errorf("traffic scope must be a regular file of at most 256 KiB")
+	}
+	// The collector atomically replaces a private, bounded file.
+	decoder := json.NewDecoder(io.LimitReader(f, (256<<10)+1))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(&cfg); err != nil {
+		return cfg, err
+	}
+	var extra any
+	if err := decoder.Decode(&extra); err != io.EOF {
+		return cfg, fmt.Errorf("traffic scope has trailing data")
+	}
+	if cfg.Version != 1 || len(cfg.PIDs) > 4096 || len(cfg.Ports) == 0 || len(cfg.Ports) > 65535 {
+		return cfg, fmt.Errorf("invalid traffic scope bounds")
+	}
+	seen := map[uint32]bool{}
+	for _, entry := range cfg.PIDs {
+		if entry.PID == 0 || entry.StartTicks == 0 || seen[entry.PID] {
+			return cfg, fmt.Errorf("invalid or duplicate traffic scope PID")
+		}
+		seen[entry.PID] = true
+	}
+	seen = map[uint32]bool{}
+	for _, port := range cfg.Ports {
+		if port == 0 || port > 65535 || seen[port] {
+			return cfg, fmt.Errorf("invalid or duplicate traffic scope port")
+		}
+		seen[port] = true
+	}
+	return cfg, nil
+}
+
+func (s *trafficScopeMaps) clear(extra trafficScopeConfig) {
+	if s.control != nil {
+		_ = s.control.Put(uint32(0), uint32(2))
+	}
+	for _, list := range [][]trafficScopePID{s.current.PIDs, extra.PIDs} {
+		for _, entry := range list {
+			_ = s.pids.Delete(entry.PID)
+		}
+	}
+	s.current.PIDs = nil
+}
+func (s *trafficScopeMaps) apply(next trafficScopeConfig) error {
+	wanted := map[uint32]bool{}
+	for _, entry := range next.PIDs {
+		wanted[entry.PID] = true
+	}
+	fail := func(err error) error { s.clear(next); return fmt.Errorf("apply traffic scope: %w", err) }
+	for _, old := range s.current.PIDs {
+		if !wanted[old.PID] {
+			if err := s.pids.Delete(old.PID); err != nil && !errors.Is(err, ebpf.ErrKeyNotExist) {
+				return fail(err)
+			}
+		}
+	}
+	wantedPorts := map[uint32]bool{}
+	for _, port := range next.Ports {
+		wantedPorts[port] = true
+	}
+	for _, port := range s.current.Ports {
+		if !wantedPorts[port] {
+			if err := s.ports.Put(port, uint32(0)); err != nil {
+				return fail(err)
+			}
+		}
+	}
+	for _, port := range next.Ports {
+		if err := s.ports.Put(port, uint32(1)); err != nil {
+			return fail(err)
+		}
+	}
+	for _, entry := range next.PIDs {
+		if err := s.pids.Put(entry.PID, entry.StartTicks); err != nil {
+			return fail(err)
+		}
+	}
+	if s.control != nil {
+		if err := s.control.Put(uint32(0), uint32(1)); err != nil {
+			return fail(err)
+		}
+	}
+	s.current = next
+	return nil
+}
+
+func (p *Probe) initializeTrafficScope() (*trafficScopeMaps, error) {
+	spec, err := btf.LoadKernelSpec()
+	if err != nil {
+		return nil, fmt.Errorf("traffic scope requires kernel BTF: %w", err)
+	}
+	var task *btf.Struct
+	if err := spec.TypeByName("task_struct", &task); err != nil {
+		return nil, err
+	}
+	members := map[string]bool{}
+	for _, member := range task.Members {
+		members[member.Name] = true
+	}
+	if !members["start_boottime"] || !members["group_leader"] {
+		return nil, fmt.Errorf("traffic scope requires task start_boottime and group_leader")
+	}
+	cfg, err := readTrafficScope(p.config.TrafficScopeFile)
+	if err != nil {
+		return nil, err
+	}
+	lookup := func(name string) (*ebpf.Map, error) {
+		m, ok, err := p.bpfManager.GetMap(name)
+		if err != nil {
+			return nil, err
+		}
+		if !ok {
+			return nil, fmt.Errorf("missing traffic scope map %s", name)
+		}
+		return m, nil
+	}
+	pidMap, err := lookup("tr_scope_pids")
+	if err != nil {
+		return nil, err
+	}
+	portMap, err := lookup("tr_scope_ports")
+	if err != nil {
+		return nil, err
+	}
+	control, err := lookup("tr_scope_ctl")
+	if err != nil {
+		return nil, err
+	}
+	scope := &trafficScopeMaps{pids: pidMap, ports: portMap, control: control}
+	if err := scope.apply(cfg); err != nil {
+		return nil, err
+	}
+	return scope, nil
+}
+
+func (p *Probe) watchTrafficScope(ctx context.Context, scope *trafficScopeMaps) {
+	ticker := time.NewTicker(200 * time.Millisecond)
+	defer ticker.Stop()
+	var previous os.FileInfo
+	failed := false
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-ticker.C:
+			info, err := os.Stat(p.config.TrafficScopeFile)
+			if err == nil && !failed && previous != nil && os.SameFile(info, previous) && info.ModTime() == previous.ModTime() && info.Size() == previous.Size() {
+				continue
+			}
+			cfg, readErr := readTrafficScope(p.config.TrafficScopeFile)
+			if err == nil {
+				err = readErr
+			}
+			if err == nil {
+				err = scope.apply(cfg)
+			}
+			if err != nil {
+				scope.clear(cfg)
+				if !failed {
+					p.Logger().Error().Err(err).Msg("traffic scope update failed; PID scope cleared")
+					if output := p.config.GetRuntimeOutput(); output != nil {
+						for _, sink := range output.EventSinks {
+							if logs, ok := sink.(domain.OperationalLogSink); ok {
+								_ = logs.PublishLog(ctx, domain.OperationalLogRecord{Message: "traffic-control-v1:scope-error"})
+							}
+						}
+					}
+				}
+				failed = true
+				continue
+			}
+			if output := p.config.GetRuntimeOutput(); output != nil {
+				for _, sink := range output.EventSinks {
+					if logs, ok := sink.(domain.OperationalLogSink); ok {
+						_ = logs.PublishLog(ctx, domain.OperationalLogRecord{Message: fmt.Sprintf("traffic-control-v1:scope-applied:%d", cfg.Revision)})
+					}
+				}
+			}
+			previous = info
+			failed = false
+		}
+	}
+}
