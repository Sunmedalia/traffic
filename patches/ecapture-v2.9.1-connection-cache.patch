+// Apache 2.4 / APR 1.7 / OpenSSL 3.5 ARM64. Validate the BIO method name
+// before interpreting Apache's output-filter context and public conn_rec prefix.
+static __always_inline void traffic_apache_metadata(u64 ssl,struct connect_event_t *conn) {
+#ifdef SSL_CONNECTION_ST_SERVER
+    char comm[16]={};
+    bpf_get_current_comm(comm,sizeof(comm));
+    if(!((comm[0]=='a' && comm[1]=='p' && comm[2]=='a') || (comm[0]=='h' && comm[1]=='t' && comm[2]=='t'))) return;
+    struct traffic_ssl_key key={.pid=traffic_process_key(),.ssl=ssl};
+    struct connect_event_t *cached=bpf_map_lookup_elem(&traffic_ssl_sockets,&key);
+    if(cached && cached->fd==0xffffffff) {__builtin_memcpy(conn,cached,sizeof(*conn));return;}
+    u64 bio=0,method=0,name=0,context=0,connection=0,local=0,client=0;
+    char method_name[18]={};
+    openssl_probe_read_user(&bio,8,(void *)(ssl+SSL_ST_WBIO));
+    if(!bio) return;
+    openssl_probe_read_user(&method,8,(void *)(bio+BIO_ST_METHOD));
+    if(!method) return;
+    openssl_probe_read_user(&name,8,(void *)(method+8));
+    if(!name) return;
+    openssl_probe_read_user(method_name,sizeof(method_name),(void *)name);
+    if(__builtin_memcmp(method_name,"APR output filter",18)!=0) return;
+    openssl_probe_read_user(&context,8,(void *)(bio+0x40));
+    if(!context) return;
+    openssl_probe_read_user(&connection,8,(void *)(context+8));
+    if(!connection) return;
+    openssl_probe_read_user(&local,8,(void *)(connection+24));
+    openssl_probe_read_user(&client,8,(void *)(connection+32));
+    if(!local || !client) return;
+    int local_family=0,client_family=0;
+    openssl_probe_read_user(&local_family,4,(void *)(local+28));
+    openssl_probe_read_user(&client_family,4,(void *)(client+28));
+    if(local_family!=client_family || (local_family!=AF_INET && local_family!=AF_INET6)) return;
+    u64 local_ip=0,client_ip=0;
+    openssl_probe_read_user(&local_ip,8,(void *)(local+48));
+    openssl_probe_read_user(&client_ip,8,(void *)(client+48));
+    if(!local_ip || !client_ip) return;
+    openssl_probe_read_user(&conn->sport,2,(void *)(client+24));
+    openssl_probe_read_user(&conn->dport,2,(void *)(local+24));
+    if(!conn->sport || !conn->dport) {__builtin_memset(conn,0,sizeof(*conn));return;}
+    if(local_family==AF_INET) {
+        openssl_probe_read_user(&conn->saddr,4,(void *)client_ip);
+        openssl_probe_read_user(&conn->daddr,4,(void *)local_ip);
+    } else {
+        openssl_probe_read_user(&conn->saddr,16,(void *)client_ip);
+        openssl_probe_read_user(&conn->daddr,16,(void *)local_ip);
+    }
+    conn->family=local_family;
+    conn->pid=bpf_get_current_pid_tgid() >> 32;
+    conn->tid=bpf_get_current_pid_tgid();
+    conn->fd=0xffffffff;
+    conn->sock=bpf_ktime_get_ns();
+    conn->timestamp_ns=conn->sock;
+    bpf_map_update_elem(&traffic_ssl_sockets,&key,conn,BPF_ANY);
+#endif
+}
