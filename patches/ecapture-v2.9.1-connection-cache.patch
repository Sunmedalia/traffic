diff --git a/internal/probe/openssl/traffic_cache_test.go b/internal/probe/openssl/traffic_cache_test.go
new file mode 100644
index 0000000..a15a9a8
--- /dev/null
+++ b/internal/probe/openssl/traffic_cache_test.go
@@ -0,0 +1,83 @@
+package openssl
+
+import (
+	"encoding/binary"
+	"golang.org/x/sys/unix"
+	"testing"
+)
+
+func TestTrafficReusedSocketCache(t *testing.T) {
+	c := &connectionCache{}
+	event := &ConnDataEvent{}
+	event.Pid = 123
+	event.Fd = 4
+	event.Sock = 9
+	event.Family = unix.AF_INET
+	event.TimestampNs = 100
+	c.observe(event)
+	event.Fd = 5
+	event.TimestampNs = 200
+	c.observe(event)
+	event.Sock = 10
+	event.TimestampNs = 300
+	c.observe(event)
+	old, ok := c.lookupAt(123, 5, 250)
+	if !ok || old.sock != 9 {
+		t.Fatalf("old socket mismatch %+v", old)
+	}
+	current, ok := c.lookupAt(123, 5, 350)
+	if !ok || current.sock != 10 {
+		t.Fatalf("new socket mismatch %+v", current)
+	}
+	if _, ok = c.lookupAt(123, 5, 99); ok {
+		t.Fatal("future connection attributed to earlier TLS event")
+	}
+}
+
+func TestTrafficInlineMetadataIgnoresStaleFDCache(t *testing.T) {
+	probe, err := NewProbe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	var oldSource, oldDestination, source, destination, comm [16]byte
+	copy(oldSource[:], []byte{192, 0, 2, 10})
+	copy(oldDestination[:], []byte{192, 0, 2, 20})
+	copy(source[:], []byte{192, 0, 2, 1})
+	copy(destination[:], []byte{192, 0, 2, 2})
+	copy(comm[:], "nginx")
+	stale := &ConnDataEvent{}
+	if err = stale.DecodeFromBytes(buildConnPayload(t, oldSource, oldDestination, comm, 0, 111, 1000, 1001, 7, unix.AF_INET, 1111, 443, 0)); err != nil {
+		t.Fatal(err)
+	}
+	probe.connections.observe(stale)
+	metadata := buildConnPayload(t, source, destination, comm, 0, 222, 1000, 1001, 7, unix.AF_INET, 54321, 443, 0)
+	metadata = append(metadata, make([]byte, 6)...)
+	inode := make([]byte, 8)
+	binary.LittleEndian.PutUint64(inode, 4321)
+	metadata = append(metadata, inode...)
+	magic := make([]byte, 8)
+	binary.LittleEndian.PutUint64(magic, 0x54524146434f4e31)
+	sample := append(append(benchmarkTLSDataSample(t), magic...), metadata...)
+	output, err := (&tlsEventDecoder{probe: probe}).Decode(nil, sample)
+	if err != nil {
+		t.Fatal(err)
+	}
+	event := output.(*Event)
+	if event.GetStreamID() != "1000_inode_4321" || event.GetSrcIP() != "192.0.2.1" || event.GetSrcPort() != 54321 || event.GetDstIP() != "192.0.2.2" {
+		t.Fatalf("stale connection won: %+v", event)
+	}
+	clone := event.Clone().(*Event)
+	if clone.GetStreamID() != event.GetStreamID() {
+		t.Fatal("snapshot identity lost during clone")
+	}
+	for size := 0; size < len(metadata); size++ {
+		short := append(append(benchmarkTLSDataSample(t), magic...), metadata[:size]...)
+		if _, err = (&tlsEventDecoder{}).Decode(nil, short); err == nil {
+			t.Fatalf("accepted short metadata %d", size)
+		}
+	}
+	padded := append(sample, make([]byte, 8)...)
+	if _, err = (&tlsEventDecoder{}).Decode(nil, padded); err != nil {
+		t.Fatalf("padding rejected: %v", err)
+	}
+}
