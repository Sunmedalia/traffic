+
+const clientQueueBytes = 8 << 20
+const serverQueueBytes = 32 << 20
+const clientQueueMessages = 16 << 10
+
+// The hub is the only producer and owns closing client queues. The writer
+// releases reservations as it consumes messages, independent of network I/O.
+func (h *Hub) enqueue(client *Client, message []byte) bool {
+	n := int64(len(message))
+	if client.pendingBytes.Add(n) > clientQueueBytes {
+		client.pendingBytes.Add(-n)
+		return false
+	}
+	if h.queuedBytes.Add(n) > serverQueueBytes {
+		h.queuedBytes.Add(-n)
+		client.pendingBytes.Add(-n)
+		return false
+	}
+	select {
+	case client.send <- append([]byte(nil), message...):
+		return true
+	default:
+		client.release(message)
+		return false
+	}
+}
