+func receiveQueueMessage(client *Client) []byte {
+	message := <-client.send
+	client.release(message)
+	return message
+}
+
+func TestClientQueueAcceptsBurstAndRetainsOrder(t *testing.T) {
+	server := NewServer("127.0.0.1:0", io.Discard)
+	defer server.Close()
+	client := newQueueClient(server, clientQueueMessages)
+	if err := server.hub.registerClient(context.Background(), client); err != nil {
+		t.Fatal(err)
+	}
+	for i := 0; i < 2048; i++ {
+		if err := server.hub.publish(context.Background(), []byte(fmt.Sprintf("event-%d", i)), false); err != nil {
+			t.Fatal(i, err)
+		}
+	}
+	for i := 0; i < 2048; i++ {
+		if got := string(receiveQueueMessage(client)); got != fmt.Sprintf("event-%d", i) {
+			t.Fatal("FIFO violated", i, got)
+		}
+	}
+	if client.pendingBytes.Load() != 0 || server.hub.queuedBytes.Load() != 0 {
+		t.Fatal("consumed messages leaked byte reservations")
+	}
+}
+
+func TestClientQueueByteLimitReleasesAbandonedTail(t *testing.T) {
+	server := NewServer("127.0.0.1:0", io.Discard)
+	defer server.Close()
+	client := newQueueClient(server, clientQueueMessages)
+	if err := server.hub.registerClient(context.Background(), client); err != nil {
+		t.Fatal(err)
+	}
+	payload := make([]byte, 1<<20)
+	for i := 0; i < 8; i++ {
+		if err := server.hub.publish(context.Background(), payload, false); err != nil {
+			t.Fatal(i, err)
+		}
+	}
+	if err := server.hub.publish(context.Background(), payload, false); !errors.Is(err, ErrBackpressure) {
+		t.Fatal("byte budget not enforced", err)
+	}
+	if client.pendingBytes.Load() != 0 || server.hub.queuedBytes.Load() != 0 {
+		t.Fatal("disconnected client's tail leaked budget")
+	}
+}
+
+func TestServerQueueBudgetAcrossClients(t *testing.T) {
+	server := NewServer("127.0.0.1:0", io.Discard)
+	defer server.Close()
+	// Exercise the same reservation method without a running network writer.
+	clients := make([]*Client, 5)
+	for i := range clients {
+		clients[i] = newQueueClient(server, clientQueueMessages)
+	}
+	defer func() {
+		for _, client := range clients {
+			client.closeQueue()
+		}
+		if server.hub.queuedBytes.Load() != 0 {
+			t.Error("closed client queues leaked server budget")
+		}
+	}()
+	payload := make([]byte, clientQueueBytes)
+	for _, client := range clients[:4] {
+		if !server.hub.enqueue(client, payload) {
+			t.Fatal("premature server budget rejection")
+		}
+	}
+	if server.hub.enqueue(clients[4], []byte("overflow")) {
+		t.Fatal("server byte budget not enforced")
+	}
+}
diff --git a/docs/agent/output-pipeline.md b/docs/agent/output-pipeline.md
--- a/docs/agent/output-pipeline.md
+++ b/docs/agent/output-pipeline.md
@@ -142,3 +142,8 @@
 When the text sink is the unrotated null device, TextHandler skips formatting
 and writing discarded text. Typed eCaptureQ events remain additive and retain
 their raw payloads; normal text destinations retain existing formatting.
+
+The eCaptureQ client queue holds at most 16384 messages or 8 MiB, with a
+32 MiB aggregate client queue budget per server. Consumption releases byte
+reservations; queue exhaustion closes that client and releases its unsent tail.
+Normal stop still does not provide a final-event acknowledgement to clients.
