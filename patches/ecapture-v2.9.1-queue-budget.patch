+func (c *Client) release(message []byte) {
+	n := int64(len(message))
+	c.pendingBytes.Add(-n)
+	c.hub.queuedBytes.Add(-n)
+}
+
+// Called only by the hub after removing the client. A concurrent writer may
+// consume messages too; each channel receive releases exactly one reservation.
+func (c *Client) closeQueue() {
+	close(c.send)
+	for message := range c.send {
+		c.release(message)
+	}
+	if c.conn != nil {
+		_ = c.conn.Close()
+	}
+}
