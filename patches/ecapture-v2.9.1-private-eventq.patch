+package cmd
+
+import "testing"
+
+func TestECaptureQListenAddressAcceptsPrivateUnixSocket(t *testing.T) {
+	for value, want := range map[string]string{
+		"ws://127.0.0.1:28257/":      "127.0.0.1:28257",
+		"unix:///run/traffic/q.sock": "unix:/run/traffic/q.sock",
+	} {
+		got, err := ecaptureQListenAddress(value)
+		if err != nil || got != want {
+			t.Fatalf("%s => %q, %v; want %q", value, got, err, want)
+		}
+	}
+	for _, value := range []string{"unix://host/q.sock", "unix:relative.sock", "unix:///q.sock?x=1", "tcp://127.0.0.1:1"} {
+		if got, err := ecaptureQListenAddress(value); err == nil {
+			t.Fatalf("%s accepted as %q", value, got)
+		}
+	}
+}
