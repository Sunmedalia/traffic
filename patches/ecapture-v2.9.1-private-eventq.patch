+package ecaptureq
+
+import (
+	"fmt"
+	"net"
+	"os"
+	"path/filepath"
+	"syscall"
+)
+
+const unixAddressPrefix = "unix:"
+
+// UnixAddress marks a listen address as a private Unix socket path.
+func UnixAddress(path string) string { return unixAddressPrefix + path }
+
+// listenPrivateUnix serves decrypted events only to the owner of the socket.
+// The parent directory must be a real directory owned by this user with no
+// group or other access, so no other local user can connect to the socket or
+// pre-create a look-alike before it is bound. An existing path is never
+// removed.
+func listenPrivateUnix(path string) (net.Listener, error) {
+	if !filepath.IsAbs(path) {
+		return nil, fmt.Errorf("ecaptureq unix socket path must be absolute")
+	}
+	info, err := os.Lstat(filepath.Dir(path))
+	if err != nil {
+		return nil, fmt.Errorf("ecaptureq unix socket directory: %w", err)
+	}
+	stat, ok := info.Sys().(*syscall.Stat_t)
+	if !info.IsDir() || !ok || int(stat.Uid) != os.Geteuid() || info.Mode().Perm()&0o077 != 0 {
+		return nil, fmt.Errorf("ecaptureq unix socket directory must be a private directory owned by uid %d", os.Geteuid())
+	}
+	listener, err := net.Listen("unix", path)
+	if err != nil {
+		return nil, err
+	}
+	if err = os.Chmod(path, 0o600); err != nil {
+		_ = listener.Close()
+		return nil, fmt.Errorf("ecaptureq unix socket permissions: %w", err)
+	}
+	return listener, nil
+}
