+package ecaptureq
+
+import (
+	"io"
+	"net"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"golang.org/x/net/websocket"
+
+	pb "github.com/gojue/ecapture/v2/protobuf/gen/v1"
+)
+
+func TestPrivateUnixSocketServesOwner(t *testing.T) {
+	dir, err := os.MkdirTemp("", "eq-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(dir)
+	path := filepath.Join(dir, "q.sock")
+	server := NewServer(UnixAddress(path), io.Discard)
+	serveErrors, err := server.StartAsync()
+	if err != nil {
+		t.Fatal(err)
+	}
+	info, err := os.Stat(path)
+	if err != nil || info.Mode().Perm() != 0o600 || info.Mode()&os.ModeSocket == 0 {
+		t.Fatalf("socket mode = %v, %v", info, err)
+	}
+	raw, err := net.Dial("unix", path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	config, err := websocket.NewConfig("ws://ecapture/", "http://ecapture/")
+	if err != nil {
+		t.Fatal(err)
+	}
+	conn, err := websocket.NewClient(config, raw)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var data []byte
+	if err = websocket.Message.Receive(conn, &data); err != nil {
+		t.Fatal(err)
+	}
+	if got := decodeEntry(t, data).GetLogType(); got != pb.LogType_LOG_TYPE_HEARTBEAT {
+		t.Fatalf("first message type = %v", got)
+	}
+	_ = conn.Close()
+	if err = server.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err = <-serveErrors; err != nil {
+		t.Fatal(err)
+	}
+	if _, err = os.Lstat(path); !os.IsNotExist(err) {
+		t.Fatalf("socket left behind: %v", err)
+	}
+}
+
+func TestPrivateUnixSocketRejectsSharedDirectory(t *testing.T) {
+	dir, err := os.MkdirTemp("", "eq-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(dir)
+	if err = os.Chmod(dir, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = NewServer(UnixAddress(filepath.Join(dir, "q.sock")), io.Discard).StartAsync(); err == nil {
+		t.Fatal("shared directory accepted")
+	}
+	existing := filepath.Join(dir, "taken")
+	if err = os.Chmod(dir, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err = os.WriteFile(existing, nil, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = NewServer(UnixAddress(existing), io.Discard).StartAsync(); err == nil {
+		t.Fatal("existing path replaced")
+	}
+	if _, err = os.Stat(existing); err != nil {
+		t.Fatalf("existing path removed: %v", err)
+	}
+	if _, err = NewServer(UnixAddress("relative.sock"), io.Discard).StartAsync(); err == nil {
+		t.Fatal("relative path accepted")
+	}
+}
