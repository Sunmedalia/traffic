+func TestTrafficProcessStartTicks(t *testing.T) {
+	root := t.TempDir()
+	if err := os.MkdirAll(filepath.Join(root, "123"), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	stat := "123 (nginx: worker) process) S 1 123 123 0 -1 4194624 1 0 0 0 0 0 0 0 20 0 1 0 987654 1 1"
+	if err := os.WriteFile(filepath.Join(root, "123", "stat"), []byte(stat), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if ticks, err := trafficProcessStartTicks(root, 123); err != nil || ticks != 987654 {
+		t.Fatalf("ticks %d, err %v", ticks, err)
+	}
+	if _, err := trafficProcessStartTicks(root, 124); !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("missing process: %v", err)
+	}
+}
