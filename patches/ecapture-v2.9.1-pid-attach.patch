+// trafficMappedCode returns the bytes process pid executes at a file offset
+// of library, or nil when the library is not mapped there.
+func trafficMappedCode(t *testing.T, pid int, library string, offset uint64) []byte {
+	t.Helper()
+	maps, err := os.ReadFile(fmt.Sprintf("/proc/%d/maps", pid))
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, line := range strings.Split(string(maps), "\n") {
+		fields := strings.Fields(line)
+		if len(fields) < 6 || fields[5] != library || !strings.Contains(fields[1], "x") {
+			continue
+		}
+		var start, end, fileOffset uint64
+		if _, err := fmt.Sscanf(fields[0]+" "+fields[2], "%x-%x %x", &start, &end, &fileOffset); err != nil || offset < fileOffset || offset+8 > fileOffset+end-start {
+			continue
+		}
+		memory, err := os.Open(fmt.Sprintf("/proc/%d/mem", pid))
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer memory.Close()
+		code := make([]byte, 8)
+		if _, err := memory.ReadAt(code, int64(start+offset-fileOffset)); err != nil {
+			t.Fatal(err)
+		}
+		return code
+	}
+	return nil
+}
+
+// trafficStartProcess starts a helper and waits until the dynamic loader has
+// mapped libc into it.
+func trafficStartProcess(t *testing.T, name string, args ...string) (int, string) {
+	t.Helper()
+	process := exec.Command(name, args...)
+	if err := process.Start(); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = process.Process.Kill(); _ = process.Wait() })
+	pid := process.Process.Pid
+	for attempt := 0; attempt < 200; attempt++ {
+		maps, _ := os.ReadFile(fmt.Sprintf("/proc/%d/maps", pid))
+		for _, line := range strings.Split(string(maps), "\n") {
+			if fields := strings.Fields(line); len(fields) >= 6 && strings.Contains(fields[5], "/libc.so") && strings.Contains(fields[1], "x") {
+				return pid, fields[5]
+			}
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	t.Skipf("%s does not map a shared libc", name)
+	return 0, ""
+}
+
+func trafficKernelAttacher(t *testing.T, library, symbol string, offsets map[string]uint64, program *ebpf.Program, carrier int) *trafficPIDAttacher {
+	t.Helper()
+	kernel, err := newTrafficTracefs()
+	if err != nil {
+		t.Skip(err)
+	}
+	probes := []*manager.Probe{{Section: "uprobe/" + symbol, EbpfFuncName: "test", AttachToFuncName: symbol, BinaryPath: library}}
+	attacher, err := newTrafficPIDAttacher(kernel, fmt.Sprintf("traffic_%d", os.Getpid()), library, probes, offsets,
+		func(string) (trafficProgram, error) { return program, nil }, carrier)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(attacher.close)
+	return attacher
+}
+
+func trafficAttach(t *testing.T, attacher *trafficPIDAttacher, pid int) {
+	t.Helper()
+	ticks, err := trafficProcessStartTicks("/proc", uint32(pid))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if reason, err := attacher.reconcile([]trafficScopePID{{uint32(pid), ticks}}); err != nil || reason != "" {
+		t.Fatalf("reconcile: %q %v", reason, err)
+	}
+}
+
+// TestTrafficPIDAttachKernel checks the kernel behaviour the attacher relies
+// on, with uprobes on libc in helper processes it starts:
+//
+//   - breakpoints are written only into the listed process, into every
+//     process after the system-wide fallback, and removed on close;
+//   - the program attached to the carrier event runs for hits in the listed
+//     process, and only there.
+//
+// The carrier is a separate sleep process so this test process, which also
+// maps libc, is never instrumented. It needs root and tracefs and only runs on
+// request:
+//
+//	TRAFFIC_PID_ATTACH_KERNEL_TEST=1 go test -run TestTrafficPIDAttachKernel ./internal/probe/openssl
+func TestTrafficPIDAttachKernel(t *testing.T) {
+	if os.Getenv("TRAFFIC_PID_ATTACH_KERNEL_TEST") != "1" || os.Geteuid() != 0 {
+		t.Skip("set TRAFFIC_PID_ATTACH_KERNEL_TEST=1 and run as root")
+	}
+	carrier, library := trafficStartProcess(t, "sleep", "60")
+	offsets, err := trafficSymbolOffsets(library)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	t.Run("breakpoints", func(t *testing.T) {
+		target, targetLibrary := trafficStartProcess(t, "sleep", "60")
+		other, otherLibrary := trafficStartProcess(t, "sleep", "60")
+		if targetLibrary != library || otherLibrary != library {
+			t.Skip("helpers map different libc files")
+		}
+		const symbol = "swab" // exported by glibc and musl, rarely called
+		offset, ok := offsets[symbol]
+		if !ok {
+			t.Skipf("%s has no %s", library, symbol)
+		}
+		file, err := os.Open(library)
+		if err != nil {
+			t.Fatal(err)
+		}
+		onDisk := make([]byte, 8)
+		_, err = file.ReadAt(onDisk, int64(offset))
+		file.Close()
+		if err != nil {
+			t.Fatal(err)
+		}
+		instrumented := func(pid int) bool { return !bytes.Equal(trafficMappedCode(t, pid, library, offset), onDisk) }
+		if instrumented(target) || instrumented(other) {
+			t.Skipf("%s is already instrumented", symbol)
+		}
+		program, err := ebpf.NewProgram(&ebpf.ProgramSpec{
+			Type:         ebpf.Kprobe,
+			License:      "GPL",
+			Instructions: asm.Instructions{asm.Mov.Imm(asm.R0, 0), asm.Return()},
+		})
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer program.Close()
+		attacher := trafficKernelAttacher(t, library, symbol, offsets, program, carrier)
+		trafficAttach(t, attacher, target)
+		if !instrumented(target) || instrumented(other) {
+			t.Fatalf("per-process attach: target %v, other %v", instrumented(target), instrumented(other))
+		}
+		attacher.mu.Lock()
+		_, err = attacher.fallBackLocked("kernel test")
+		attacher.mu.Unlock()
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !instrumented(target) || !instrumented(other) {
+			t.Fatalf("system-wide fallback: target %v, other %v", instrumented(target), instrumented(other))
+		}
+		event := attacher.hooks[0].name
+		attacher.close()
+		if instrumented(target) || instrumented(other) {
+			t.Fatalf("after close: target %v, other %v", instrumented(target), instrumented(other))
+		}
+		if _, err := attacher.kernel.(*trafficTracefs).eventID(attacher.group, event); err == nil {
+			t.Fatal("trace event left in tracefs")
+		}
+	})
+
+	t.Run("program runs for listed process", func(t *testing.T) {
+		const symbol = "write"
+		if _, ok := offsets[symbol]; !ok {
+			t.Skipf("%s has no %s", library, symbol)
+		}
+		// Each hit records the caller's process ID.
+		hits, err := ebpf.NewMap(&ebpf.MapSpec{Type: ebpf.Hash, KeySize: 4, ValueSize: 8, MaxEntries: 64})
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer hits.Close()
+		program, err := ebpf.NewProgram(&ebpf.ProgramSpec{
+			Type:    ebpf.Kprobe,
+			License: "GPL",
+			Instructions: asm.Instructions{
+				asm.FnGetCurrentPidTgid.Call(),
+				asm.RSh.Imm(asm.R0, 32),
+				asm.StoreMem(asm.RFP, -4, asm.R0, asm.Word),
+				asm.Mov.Imm(asm.R1, 1),
+				asm.StoreMem(asm.RFP, -16, asm.R1, asm.DWord),
+				asm.LoadMapPtr(asm.R1, hits.FD()),
+				asm.Mov.Reg(asm.R2, asm.RFP),
+				asm.Add.Imm(asm.R2, -4),
+				asm.Mov.Reg(asm.R3, asm.RFP),
+				asm.Add.Imm(asm.R3, -16),
+				asm.Mov.Imm(asm.R4, 0),
+				asm.FnMapUpdateElem.Call(),
+				asm.Mov.Imm(asm.R0, 0),
+				asm.Return(),
+			},
+		})
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer program.Close()
+		attacher := trafficKernelAttacher(t, library, symbol, offsets, program, carrier)
+		// coreutils yes writes in a loop; exec leaves stdout on /dev/null.
+		target, targetLibrary := trafficStartProcess(t, "yes")
+		other, otherLibrary := trafficStartProcess(t, "yes")
+		if targetLibrary != library || otherLibrary != library {
+			t.Skip("helpers map different libc files")
+		}
+		trafficAttach(t, attacher, target)
+		var marker uint64
+		deadline := time.Now().Add(2 * time.Second)
+		for hits.Lookup(uint32(target), &marker) != nil {
+			if time.Now().After(deadline) {
+				t.Fatal("program attached to the carrier never ran for the listed process")
+			}
+			time.Sleep(10 * time.Millisecond)
+		}
+		time.Sleep(100 * time.Millisecond)
+		if hits.Lookup(uint32(other), &marker) == nil {
+			t.Fatal("program ran for a process outside the scope")
+		}
+		if hits.Lookup(uint32(os.Getpid()), &marker) == nil {
+			t.Fatal("program ran for the test process")
+		}
+	})
+}
diff --git a/internal/probe/openssl/traffic_pid_attach_probe.go b/internal/probe/openssl/traffic_pid_attach_probe.go
new file mode 100644
index 0000000..cb0c500
--- /dev/null
+++ b/internal/probe/openssl/traffic_pid_attach_probe.go
@@ -0,0 +1,165 @@
+package openssl
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"strings"
+	"syscall"
+
+	"github.com/cilium/ebpf"
+	"github.com/cilium/ebpf/link"
+	manager "github.com/gojue/ebpfmanager"
+
+	"github.com/gojue/ecapture/v2/internal/domain"
+)
+
+const (
+	trafficAttachModePID    = "traffic-control-v1:attach-mode:pid"
+	trafficAttachModeSystem = "traffic-control-v1:attach-mode:system:"
+)
+
+func (p *Probe) trafficProgram(name string) (*ebpf.Program, error) {
+	programs, ok, err := p.bpfManager.GetProgram(manager.ProbeIdentificationPair{EbpfFuncName: name})
+	if err != nil {
+		return nil, err
+	}
+	if !ok || len(programs) == 0 || programs[0] == nil {
+		return nil, fmt.Errorf("program %s is not loaded", name)
+	}
+	return programs[0], nil
+}
+
+// attachTrafficUprobes runs after the manager attached the kprobes and the
+// scope maps hold the first PID set, and before the probe reports ready.
+func (p *Probe) attachTrafficUprobes(ctx context.Context, scope *trafficScopeMaps) error {
+	attacher, err := p.newTrafficKernelAttacher()
+	if err != nil {
+		p.Logger().Warn().Err(err).Msg("per-process OpenSSL uprobes unavailable; attaching system-wide")
+		if err := p.attachSystemUprobes(); err != nil {
+			return err
+		}
+		p.publishTrafficControl(ctx, trafficAttachModeSystem+trafficControlReason(err))
+		return nil
+	}
+	reason, err := attacher.reconcile(scope.current.PIDs)
+	if err != nil {
+		attacher.close()
+		return err
+	}
+	p.pidAttach = attacher
+	if reason != "" {
+		p.publishTrafficControl(ctx, trafficAttachModeSystem+trafficControlReason(errors.New(reason)))
+		return nil
+	}
+	p.Logger().Info().Int("processes", attacher.attachedProcesses()).Msg("OpenSSL uprobes attached per process")
+	p.publishTrafficControl(ctx, trafficAttachModePID)
+	return nil
+}
+
+func (p *Probe) newTrafficKernelAttacher() (*trafficPIDAttacher, error) {
+	kernel, err := newTrafficTracefs()
+	if err != nil {
+		return nil, err
+	}
+	kernel.removeStale()
+	offsets, err := trafficSymbolOffsets(p.config.OpensslPath)
+	if err != nil {
+		return nil, err
+	}
+	program := func(name string) (trafficProgram, error) { return p.trafficProgram(name) }
+	self := os.Getpid()
+	return newTrafficPIDAttacher(kernel, fmt.Sprintf("traffic_%d", self), p.config.OpensslPath, p.trafficUprobes, offsets, program, self)
+}
+
+// attachSystemUprobes attaches the hooks as upstream's manager does: system
+// wide, skipping symbols the library does not export.
+func (p *Probe) attachSystemUprobes() error {
+	executable, err := link.OpenExecutable(p.config.OpensslPath)
+	if err != nil {
+		return err
+	}
+	for _, probe := range p.trafficUprobes {
+		program, err := p.trafficProgram(probe.EbpfFuncName)
+		if err != nil {
+			p.closeSystemUprobes()
+			return err
+		}
+		var attached link.Link
+		if strings.HasPrefix(probe.Section, "uretprobe/") {
+			attached, err = executable.Uretprobe(probe.AttachToFuncName, program, nil)
+		} else {
+			attached, err = executable.Uprobe(probe.AttachToFuncName, program, nil)
+		}
+		if errors.Is(err, link.ErrNoSymbol) || errors.Is(err, syscall.ENOENT) || errors.Is(err, syscall.EINVAL) {
+			continue
+		}
+		if err != nil {
+			p.closeSystemUprobes()
+			return fmt.Errorf("attach %s: %w", probe.Section, err)
+		}
+		p.systemUprobes = append(p.systemUprobes, attached)
+	}
+	return nil
+}
+
+func (p *Probe) closeSystemUprobes() {
+	for _, attached := range p.systemUprobes {
+		_ = attached.Close()
+	}
+	p.systemUprobes = nil
+}
+
+// reconcileTrafficUprobes follows a scope update. An error means even the
+// system-wide fallback failed; the caller then clears the scope.
+func (p *Probe) reconcileTrafficUprobes(ctx context.Context, pids []trafficScopePID) error {
+	if p.pidAttach == nil {
+		return nil
+	}
+	reason, err := p.pidAttach.reconcile(pids)
+	if err != nil {
+		return err
+	}
+	if reason != "" {
+		p.Logger().Warn().Str("reason", reason).Msg("per-process OpenSSL uprobes switched to system-wide")
+		p.publishTrafficControl(ctx, trafficAttachModeSystem+trafficControlReason(errors.New(reason)))
+	}
+	return nil
+}
+
+// detachTrafficUprobes may run while the scope watcher is still reconciling.
+// pidAttach is written once in Start, before the watcher starts, and close
+// turns later reconciles into no-ops under the attacher's lock.
+func (p *Probe) detachTrafficUprobes() {
+	if p.pidAttach != nil {
+		p.pidAttach.close()
+	}
+	p.closeSystemUprobes()
+}
+
+func (p *Probe) publishTrafficControl(ctx context.Context, message string) {
+	output := p.config.GetRuntimeOutput()
+	if output == nil {
+		return
+	}
+	for _, sink := range output.EventSinks {
+		if logs, ok := sink.(domain.OperationalLogSink); ok {
+			_ = logs.PublishLog(ctx, domain.OperationalLogRecord{Message: message})
+		}
+	}
+}
+
+// trafficControlReason keeps a control message on one bounded line.
+func trafficControlReason(err error) string {
+	reason := strings.Map(func(r rune) rune {
+		if r < 0x20 || r == 0x7f {
+			return ' '
+		}
+		return r
+	}, err.Error())
+	if len(reason) > 200 {
+		reason = reason[:200]
+	}
+	return reason
+}
diff --git a/internal/probe/openssl/traffic_pid_attach_test.go b/internal/probe/openssl/traffic_pid_attach_test.go
new file mode 100644
index 0000000..709ef7f
--- /dev/null
+++ b/internal/probe/openssl/traffic_pid_attach_test.go
@@ -0,0 +1,390 @@
+package openssl
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"syscall"
+	"testing"
+
+	manager "github.com/gojue/ebpfmanager"
+)
+
+type fakeProgram int
+
+func (p fakeProgram) FD() int { return int(p) }
+
+type fakeAttachEvent struct {
+	id      uint64
+	pid     int
+	program int // carrier program FD, 0 for filter-only events
+}
+
+type fakeAttachKernel struct {
+	nextFD, nextID int
+	defined        map[string]uint64
+	events         map[int]fakeAttachEvent
+	ticks          map[uint32]uint64
+	openErr        map[int]error // by pid
+	carrierErr     map[uint64]error
+	log            []string
+}
+
+func newFakeAttachKernel() *fakeAttachKernel {
+	return &fakeAttachKernel{nextFD: 100, defined: map[string]uint64{}, events: map[int]fakeAttachEvent{}, ticks: map[uint32]uint64{}, openErr: map[int]error{}, carrierErr: map[uint64]error{}}
+}
+
+func (k *fakeAttachKernel) defineEvent(group, name, path string, offset uint64, ret bool) (uint64, error) {
+	key := group + "/" + name
+	if _, ok := k.defined[key]; ok {
+		return 0, os.ErrExist
+	}
+	k.nextID++
+	k.defined[key] = uint64(k.nextID)
+	k.log = append(k.log, "define "+trafficUprobeDefinition(group, name, path, offset, ret))
+	return uint64(k.nextID), nil
+}
+
+func (k *fakeAttachKernel) removeEvent(group, name string) error {
+	delete(k.defined, group+"/"+name)
+	k.log = append(k.log, "remove "+name)
+	return nil
+}
+
+func (k *fakeAttachKernel) open(id uint64, pid, program int) int {
+	k.nextFD++
+	k.events[k.nextFD] = fakeAttachEvent{id: id, pid: pid, program: program}
+	k.log = append(k.log, fmt.Sprintf("open %d pid %d", id, pid))
+	return k.nextFD
+}
+
+func (k *fakeAttachKernel) openEvent(id uint64, pid int) (int, error) {
+	if err := k.openErr[pid]; err != nil {
+		return -1, err
+	}
+	return k.open(id, pid, 0), nil
+}
+
+func (k *fakeAttachKernel) openCarrier(id uint64, pid int, program trafficProgram) (int, error) {
+	if err := k.carrierErr[id]; err != nil {
+		return -1, err
+	}
+	return k.open(id, pid, program.FD()), nil
+}
+
+func (k *fakeAttachKernel) closeEvent(fd int) error {
+	event, ok := k.events[fd]
+	if !ok {
+		panic(fmt.Sprintf("closing unknown fd %d", fd))
+	}
+	delete(k.events, fd)
+	k.log = append(k.log, fmt.Sprintf("close %d pid %d", event.id, event.pid))
+	return nil
+}
+
+func (k *fakeAttachKernel) startTicks(pid uint32) (uint64, error) {
+	ticks, ok := k.ticks[pid]
+	if !ok {
+		return 0, os.ErrNotExist
+	}
+	return ticks, nil
+}
+
+// filterPIDs lists the filter-only events per pid.
+func (k *fakeAttachKernel) filterPIDs() map[int]int {
+	pids := map[int]int{}
+	for _, event := range k.events {
+		if event.program == 0 {
+			pids[event.pid]++
+		}
+	}
+	return pids
+}
+
+const trafficTestLibrary = "/proc/1/root/usr/lib/libssl.so.3"
+
+func trafficTestProbes() []*manager.Probe {
+	return []*manager.Probe{
+		{Section: "uprobe/SSL_read", EbpfFuncName: "probe_entry_SSL_read", AttachToFuncName: "SSL_read", BinaryPath: trafficTestLibrary},
+		{Section: "uretprobe/SSL_read", EbpfFuncName: "probe_ret_SSL_read", AttachToFuncName: "SSL_read", BinaryPath: trafficTestLibrary},
+		{Section: "uprobe/SSL_set_rfd", EbpfFuncName: "probe_SSL_set_fd", AttachToFuncName: "SSL_set_rfd", BinaryPath: trafficTestLibrary},
+	}
+}
+
+func newTestAttacher(t *testing.T, kernel *fakeAttachKernel) *trafficPIDAttacher {
+	t.Helper()
+	// SSL_set_rfd is missing from the library, like OpenSSL builds without it.
+	offsets := map[string]uint64{"SSL_read": 0x1a2b}
+	programs := map[string]int{"probe_entry_SSL_read": 7, "probe_ret_SSL_read": 8, "probe_SSL_set_fd": 9}
+	program := func(name string) (trafficProgram, error) { return fakeProgram(programs[name]), nil }
+	attacher, err := newTrafficPIDAttacher(kernel, "traffic_42", trafficTestLibrary, trafficTestProbes(), offsets, program, 42)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return attacher
+}
+
+func TestTrafficSplitUprobesKeepsKprobesAndOtherBinaries(t *testing.T) {
+	probes := append(trafficTestProbes(),
+		&manager.Probe{Section: "kprobe/tcp_recvmsg", EbpfFuncName: "traffic_tcp_recvmsg", AttachToFuncName: "tcp_recvmsg"},
+		&manager.Probe{Section: "uprobe/SSL_write", EbpfFuncName: "probe_entry_SSL_write", AttachToFuncName: "SSL_write", BinaryPath: "/other/libssl.so"},
+		&manager.Probe{Section: "uprobe/bssl_keylog", EbpfFuncName: "uprobe_bssl_keylog", AttachToFuncName: "ssl_log_secret", BinaryPath: trafficTestLibrary, UAddress: 0x10},
+	)
+	managed, uprobes := trafficSplitUprobes(probes, trafficTestLibrary)
+	if len(uprobes) != 3 || len(managed) != 3 {
+		t.Fatalf("managed %d, uprobes %d", len(managed), len(uprobes))
+	}
+	for _, probe := range managed {
+		if probe.BinaryPath == trafficTestLibrary && probe.UAddress == 0 {
+			t.Fatalf("library uprobe %s stayed with the manager", probe.Section)
+		}
+	}
+}
+
+func TestTrafficUprobeDefinitionSyntax(t *testing.T) {
+	if got := trafficUprobeDefinition("traffic_42", trafficEventName("SSL_read", false), "/lib/libssl.so.3", 0x1a2b, false); got != "p:traffic_42/p_SSL_read /lib/libssl.so.3:0x1a2b" {
+		t.Fatal(got)
+	}
+	if got := trafficUprobeDefinition("traffic_42", trafficEventName("SSL_read@v3", true), "/lib/libssl.so.3", 0x10, true); got != "r:traffic_42/r_SSL_read_v3 /lib/libssl.so.3:0x10" {
+		t.Fatal(got)
+	}
+}
+
+// The file offset computed for a function must address the bytes this
+// process executes for it, which is how the kernel places a uprobe. Shared
+// libraries mapped here (libc, the dynamic loader) keep their dynamic symbols
+// even though go test strips the test binary.
+func TestTrafficSymbolOffsetsMatchMappedCode(t *testing.T) {
+	maps, err := os.ReadFile("/proc/self/maps")
+	if err != nil {
+		t.Skip(err)
+	}
+	memory, err := os.Open("/proc/self/mem")
+	if err != nil {
+		t.Skip(err)
+	}
+	defer memory.Close()
+	checked := 0
+	seen := map[string]bool{}
+	for _, line := range strings.Split(string(maps), "\n") {
+		fields := strings.Fields(line)
+		if len(fields) < 6 || !strings.Contains(fields[1], "x") || !strings.HasPrefix(fields[5], "/") || seen[fields[5]] {
+			continue
+		}
+		var start, end, fileOffset uint64
+		if _, err := fmt.Sscanf(fields[0]+" "+fields[2], "%x-%x %x", &start, &end, &fileOffset); err != nil {
+			continue
+		}
+		seen[fields[5]] = true
+		offsets, err := trafficSymbolOffsets(fields[5])
+		if err != nil {
+			continue
+		}
+		names := make([]string, 0, len(offsets))
+		for name := range offsets {
+			names = append(names, name)
+		}
+		sort.Strings(names)
+		perFile := 0
+		for _, name := range names {
+			offset := offsets[name]
+			if offset < fileOffset || offset+16 > fileOffset+(end-start) {
+				continue
+			}
+			onDisk, inMemory := make([]byte, 16), make([]byte, 16)
+			file, err := os.Open(fields[5])
+			if err != nil {
+				break
+			}
+			_, readErr := file.ReadAt(onDisk, int64(offset))
+			file.Close()
+			if readErr != nil {
+				t.Fatalf("%s %s: %v", fields[5], name, readErr)
+			}
+			if _, err := memory.ReadAt(inMemory, int64(start+offset-fileOffset)); err != nil {
+				t.Fatalf("%s %s: %v", fields[5], name, err)
+			}
+			if string(onDisk) != string(inMemory) {
+				t.Fatalf("%s %s at file offset %#x: file % x, memory % x", fields[5], name, offset, onDisk, inMemory)
+			}
+			checked++
+			if perFile++; perFile == 8 {
+				break
+			}
+		}
+	}
+	if checked == 0 {
+		t.Skip("no mapped executable with function symbols")
+	}
+}
