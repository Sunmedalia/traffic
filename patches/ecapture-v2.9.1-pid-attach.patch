+func TestTrafficPIDAttacherFollowsScope(t *testing.T) {
+	kernel := newFakeAttachKernel()
+	attacher := newTestAttacher(t, kernel)
+	// SSL_read entry and return; the missing SSL_set_rfd is skipped.
+	if len(attacher.hooks) != 2 || len(kernel.defined) != 2 {
+		t.Fatalf("hooks %d, defined %v", len(attacher.hooks), kernel.defined)
+	}
+	for _, event := range kernel.events {
+		if event.pid != 42 || event.program == 0 {
+			t.Fatalf("carrier %+v must hold the program on eCapture's own process", event)
+		}
+	}
+	kernel.ticks = map[uint32]uint64{10: 100, 11: 110, 12: 120, 14: 1}
+	kernel.openErr[13] = syscall.ESRCH
+	reconcile := func(scope ...trafficScopePID) {
+		t.Helper()
+		if reason, err := attacher.reconcile(scope); err != nil || reason != "" {
+			t.Fatalf("reconcile: %q %v", reason, err)
+		}
+	}
+	reconcile(trafficScopePID{10, 100}, trafficScopePID{11, 110})
+	if got := kernel.filterPIDs(); len(got) != 2 || got[10] != 2 || got[11] != 2 {
+		t.Fatalf("filter events %v", got)
+	}
+	// 10 leaves, 12 arrives, 13 has exited, 14's PID now belongs to another
+	// process (start time 1, not 140).
+	reconcile(trafficScopePID{11, 110}, trafficScopePID{12, 120}, trafficScopePID{13, 130}, trafficScopePID{14, 140})
+	if got := kernel.filterPIDs(); len(got) != 2 || got[11] != 2 || got[12] != 2 {
+		t.Fatalf("filter events %v", got)
+	}
+	if attacher.attachedProcesses() != 2 {
+		t.Fatalf("attached %d", attacher.attachedProcesses())
+	}
+	// Same PID, new start time: the old events are replaced.
+	kernel.ticks[11] = 111
+	before := len(kernel.log)
+	reconcile(trafficScopePID{11, 111}, trafficScopePID{12, 120})
+	if got := strings.Join(kernel.log[before:], ";"); !strings.Contains(got, "close 1 pid 11") || !strings.Contains(got, "open 1 pid 11") {
+		t.Fatalf("PID 11 not reattached: %s", got)
+	}
+	attacher.close()
+	if len(kernel.events) != 0 || len(kernel.defined) != 0 {
+		t.Fatalf("left events %v, definitions %v", kernel.events, kernel.defined)
+	}
+	if reason, err := attacher.reconcile([]trafficScopePID{{12, 120}}); err != nil || reason != "" || len(kernel.events) != 0 {
+		t.Fatal("reconcile after close attached processes")
+	}
+}
