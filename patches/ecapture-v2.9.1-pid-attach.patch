diff --git a/internal/probe/openssl/traffic_pid_attach.go b/internal/probe/openssl/traffic_pid_attach.go
new file mode 100644
index 0000000..8da59d1
--- /dev/null
+++ b/internal/probe/openssl/traffic_pid_attach.go
@@ -0,0 +1,470 @@
+package openssl
+
+// Per-process OpenSSL uprobes (--traffic-pid-attach).
+//
+// Upstream attaches every OpenSSL uprobe system-wide. The kernel then writes a
+// breakpoint into every process that maps the library file, so unrelated
+// services sharing libssl (PHP-FPM workers calling out over HTTPS, database
+// clients, monitoring agents) trap on each SSL_read and SSL_write even though
+// the BPF scope drops their events afterwards.
+//
+// Here each hook is one tracefs uprobe event. The BPF program is attached once
+// per hook, to a carrier perf event on eCapture's own process, which never
+// maps libssl. Each target process gets one disabled, filter-only perf event
+// per hook. The kernel's trace_uprobe filter installs breakpoints only in the
+// address spaces of the events' tasks, and every hit still passes a single
+// consumer and runs the program once; adding or removing a process opens or
+// closes its filter events. Opening a pid -1 filter event on the same trace
+// events makes them system-wide without attaching the program a second time.
+//
+// Coverage never drops below upstream: if tracefs cannot be set up the probe
+// attaches upstream-style system-wide links, and if a target cannot be added
+// later the events become system-wide before any per-process event closes.
+
+import (
+	"debug/elf"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strconv"
+	"strings"
+	"sync"
+	"syscall"
+	"unsafe"
+
+	manager "github.com/gojue/ebpfmanager"
+	"golang.org/x/sys/unix"
+)
+
+// trafficProgram is the part of *ebpf.Program the attacher needs.
+type trafficProgram interface{ FD() int }
+
+// trafficAttachKernel is the kernel interface of the attacher; tests replace it.
+type trafficAttachKernel interface {
+	defineEvent(group, name, path string, offset uint64, ret bool) (uint64, error)
+	removeEvent(group, name string) error
+	// openEvent opens a disabled filter-only event: pid > 0 targets that
+	// process, pid -1 makes the trace event system-wide.
+	openEvent(id uint64, pid int) (int, error)
+	// openCarrier opens an enabled event on pid with the program attached.
+	openCarrier(id uint64, pid int, program trafficProgram) (int, error)
+	closeEvent(fd int) error
+	startTicks(pid uint32) (uint64, error)
+}
+
+type trafficHook struct {
+	name    string
+	symbol  string
+	ret     bool
+	offset  uint64
+	program trafficProgram
+	id      uint64
+	carrier int
+}
+
+type trafficAttachedProcess struct {
+	ticks uint64
+	fds   []int
+}
+
+type trafficPIDAttacher struct {
+	mu       sync.Mutex
+	kernel   trafficAttachKernel
+	group    string
+	hooks    []*trafficHook
+	pids     map[uint32]trafficAttachedProcess
+	system   []int
+	fallback string
+	closed   bool
+}
+
+// trafficSplitUprobes moves the symbol-addressed uprobes on the OpenSSL
+// library out of the manager's probe list. Their programs stay in the loaded
+// collection; kprobes and anything addressed by raw offset stay with the
+// manager.
+func trafficSplitUprobes(probes []*manager.Probe, library string) (managed, uprobes []*manager.Probe) {
+	for _, probe := range probes {
+		isUprobe := strings.HasPrefix(probe.Section, "uprobe/") || strings.HasPrefix(probe.Section, "uretprobe/")
+		if isUprobe && probe.BinaryPath == library && probe.AttachToFuncName != "" && probe.UAddress == 0 && probe.UprobeOffset == 0 {
+			uprobes = append(uprobes, probe)
+			continue
+		}
+		managed = append(managed, probe)
+	}
+	return managed, uprobes
+}
+
+// trafficSymbolOffsets returns the file offset of each function symbol, like
+// cilium/ebpf's Executable: dynamic symbols override static ones, and the
+// address is translated through the executable PT_LOAD segment holding it.
+func trafficSymbolOffsets(path string) (map[string]uint64, error) {
+	file, err := elf.Open(path)
+	if err != nil {
+		return nil, err
+	}
+	defer file.Close()
+	if file.Type != elf.ET_EXEC && file.Type != elf.ET_DYN {
+		return nil, fmt.Errorf("%s is not an executable or shared object", path)
+	}
+	symbols, err := file.Symbols()
+	if err != nil && !errors.Is(err, elf.ErrNoSymbols) {
+		return nil, err
+	}
+	dynamic, err := file.DynamicSymbols()
+	if err != nil && !errors.Is(err, elf.ErrNoSymbols) {
+		return nil, err
+	}
+	offsets := map[string]uint64{}
+	for _, symbol := range append(symbols, dynamic...) {
+		if elf.ST_TYPE(symbol.Info) != elf.STT_FUNC || symbol.Value == 0 {
+			continue
+		}
+		address := symbol.Value
+		for _, segment := range file.Progs {
+			if segment.Type == elf.PT_LOAD && segment.Flags&elf.PF_X != 0 && segment.Vaddr <= symbol.Value && symbol.Value < segment.Vaddr+segment.Memsz {
+				address = symbol.Value - segment.Vaddr + segment.Off
+				break
+			}
+		}
+		offsets[symbol.Name] = address
+	}
+	return offsets, nil
+}
+
+var (
+	trafficTracefsIdentifier = regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_]*$`)
+	trafficTracefsInvalid    = regexp.MustCompile(`[^A-Za-z0-9_]`)
+)
+
+func trafficEventName(symbol string, ret bool) string {
+	prefix := "p_"
+	if ret {
+		prefix = "r_"
+	}
+	return prefix + trafficTracefsInvalid.ReplaceAllString(symbol, "_")
+}
+
+// newTrafficPIDAttacher defines one trace event and carrier per probe, as the
+// manager attaches each probe once. Symbols missing from the library are
+// skipped, as the manager skips ENOENT attach errors. Any other failure undoes
+// everything created so far.
+func newTrafficPIDAttacher(kernel trafficAttachKernel, group, library string, probes []*manager.Probe, offsets map[string]uint64, program func(name string) (trafficProgram, error), self int) (*trafficPIDAttacher, error) {
+	if !trafficTracefsIdentifier.MatchString(group) {
+		return nil, fmt.Errorf("invalid trace event group %q", group)
+	}
+	if strings.ContainsAny(library, " \t\n:") {
+		return nil, fmt.Errorf("library path %q cannot be used in a uprobe definition", library)
+	}
+	a := &trafficPIDAttacher{kernel: kernel, group: group, pids: map[uint32]trafficAttachedProcess{}}
+	for index, probe := range probes {
+		ret := strings.HasPrefix(probe.Section, "uretprobe/")
+		offset, ok := offsets[probe.AttachToFuncName]
+		if !ok {
+			continue
+		}
+		name := fmt.Sprintf("%s_%d", trafficEventName(probe.AttachToFuncName, ret), index)
+		prog, err := program(probe.EbpfFuncName)
+		if err != nil {
+			a.close()
+			return nil, fmt.Errorf("program %s: %w", probe.EbpfFuncName, err)
+		}
+		hook := &trafficHook{name: name, symbol: probe.AttachToFuncName, ret: ret, offset: offset, program: prog, carrier: -1}
+		if hook.id, err = kernel.defineEvent(group, name, library, offset, ret); err != nil {
+			a.close()
+			return nil, fmt.Errorf("define %s: %w", name, err)
+		}
+		a.hooks = append(a.hooks, hook)
+		if hook.carrier, err = kernel.openCarrier(hook.id, self, prog); err != nil {
+			hook.carrier = -1
+			a.close()
+			return nil, fmt.Errorf("attach %s: %w", name, err)
+		}
+	}
+	if len(a.hooks) == 0 {
+		return nil, fmt.Errorf("no OpenSSL hook symbol found in %s", library)
+	}
+	return a, nil
+}
+
+// reconcile makes the per-process events match the scope. It returns a
+// reason when it had to switch to system-wide events, and an error only when
+// even that failed.
+func (a *trafficPIDAttacher) reconcile(scope []trafficScopePID) (string, error) {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if a.closed || a.fallback != "" {
+		return "", nil
+	}
+	wanted := make(map[uint32]uint64, len(scope))
+	for _, entry := range scope {
+		wanted[entry.PID] = entry.StartTicks
+	}
+	for pid, process := range a.pids {
+		if ticks, ok := wanted[pid]; !ok || ticks != process.ticks {
+			a.closeFDs(process.fds)
+			delete(a.pids, pid)
+		}
+	}
+	for pid, ticks := range wanted {
+		if _, ok := a.pids[pid]; ok {
+			continue
+		}
+		fds, err := a.addProcess(pid, ticks)
+		if err != nil {
+			return a.fallBackLocked(fmt.Sprintf("pid %d: %v", pid, err))
+		}
+		if fds != nil {
+			a.pids[pid] = trafficAttachedProcess{ticks: ticks, fds: fds}
+		}
+	}
+	return "", nil
+}
+
+// addProcess returns nil fds when the process exited or its PID now belongs
+// to another process; the BPF scope drops such a PID anyway.
+func (a *trafficPIDAttacher) addProcess(pid uint32, ticks uint64) ([]int, error) {
+	fds := make([]int, 0, len(a.hooks))
+	for _, hook := range a.hooks {
+		fd, err := a.kernel.openEvent(hook.id, int(pid))
+		if errors.Is(err, syscall.ESRCH) {
+			a.closeFDs(fds)
+			return nil, nil
+		}
+		if err != nil {
+			a.closeFDs(fds)
+			return nil, err
+		}
+		fds = append(fds, fd)
+	}
+	// Checked after opening: an event that holds a reused PID's task shows a
+	// different start time here, so it is never kept.
+	live, err := a.kernel.startTicks(pid)
+	if errors.Is(err, os.ErrNotExist) || errors.Is(err, syscall.ESRCH) || (err == nil && live != ticks) {
+		a.closeFDs(fds)
+		return nil, nil
+	}
+	if err != nil {
+		a.closeFDs(fds)
+		return nil, fmt.Errorf("verify start time: %w", err)
+	}
+	return fds, nil
+}
+
+// fallBackLocked opens the system-wide events first, so the website's
+// processes stay covered, then drops the per-process events.
+func (a *trafficPIDAttacher) fallBackLocked(reason string) (string, error) {
+	opened := make([]int, 0, len(a.hooks))
+	for _, hook := range a.hooks {
+		fd, err := a.kernel.openEvent(hook.id, -1)
+		if err != nil {
+			a.closeFDs(opened)
+			return "", fmt.Errorf("%s; system-wide fallback for %s failed: %w", reason, hook.name, err)
+		}
+		opened = append(opened, fd)
+	}
+	a.system = opened
+	for pid, process := range a.pids {
+		a.closeFDs(process.fds)
+		delete(a.pids, pid)
+	}
+	a.fallback = reason
+	return reason, nil
+}
+
+func (a *trafficPIDAttacher) attachedProcesses() int {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	return len(a.pids)
+}
+
+func (a *trafficPIDAttacher) closeFDs(fds []int) {
+	for _, fd := range fds {
+		_ = a.kernel.closeEvent(fd)
+	}
+}
+
+// close detaches every hook: per-process and system-wide filter events,
+// then the carriers holding the programs, then the trace events.
+func (a *trafficPIDAttacher) close() {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if a.closed {
+		return
+	}
+	a.closed = true
+	for pid, process := range a.pids {
+		a.closeFDs(process.fds)
+		delete(a.pids, pid)
+	}
+	a.closeFDs(a.system)
+	a.system = nil
+	for _, hook := range a.hooks {
+		if hook.carrier >= 0 {
+			_ = a.kernel.closeEvent(hook.carrier)
+			hook.carrier = -1
+		}
+		_ = a.kernel.removeEvent(a.group, hook.name)
+	}
+}
+
+// trafficTracefs is the Linux implementation over tracefs and perf_event_open.
+type trafficTracefs struct{ root string }
+
+func newTrafficTracefs() (*trafficTracefs, error) {
+	for _, root := range []string{"/sys/kernel/tracing", "/sys/kernel/debug/tracing"} {
+		if info, err := os.Stat(filepath.Join(root, "uprobe_events")); err == nil && info.Mode().IsRegular() {
+			return &trafficTracefs{root: root}, nil
+		}
+	}
+	return nil, errors.New("tracefs uprobe_events not found")
+}
+
+func (t *trafficTracefs) write(line string) error {
+	file, err := os.OpenFile(filepath.Join(t.root, "uprobe_events"), os.O_WRONLY|os.O_APPEND, 0)
+	if err != nil {
+		return err
+	}
+	_, err = file.WriteString(line)
+	return errors.Join(err, file.Close())
+}
+
+func (t *trafficTracefs) eventID(group, name string) (uint64, error) {
+	data, err := os.ReadFile(filepath.Join(t.root, "events", group, name, "id"))
+	if err != nil {
+		return 0, err
+	}
+	return strconv.ParseUint(strings.TrimSpace(string(data)), 10, 64)
+}
+
+func (t *trafficTracefs) defineEvent(group, name, path string, offset uint64, ret bool) (uint64, error) {
+	if !trafficTracefsIdentifier.MatchString(name) {
+		return 0, fmt.Errorf("invalid trace event name %q", name)
+	}
+	if _, err := t.eventID(group, name); err == nil {
+		return 0, fmt.Errorf("trace event %s/%s: %w", group, name, os.ErrExist)
+	}
+	if err := t.write(trafficUprobeDefinition(group, name, path, offset, ret)); err != nil {
+		return 0, err
+	}
+	id, err := t.eventID(group, name)
+	if err != nil {
+		_ = t.removeEvent(group, name)
+		return 0, err
+	}
+	return id, nil
+}
+
+func trafficUprobeDefinition(group, name, path string, offset uint64, ret bool) string {
+	kind := "p"
+	if ret {
+		kind = "r"
+	}
+	return fmt.Sprintf("%s:%s/%s %s:%#x", kind, group, name, path, offset)
+}
+
+func (t *trafficTracefs) removeEvent(group, name string) error {
+	return t.write("-:" + group + "/" + name)
+}
+
+func trafficPerfAttr(id uint64, disabled bool) unix.PerfEventAttr {
+	attr := unix.PerfEventAttr{
+		Type:        unix.PERF_TYPE_TRACEPOINT,
+		Config:      id,
+		Sample_type: unix.PERF_SAMPLE_RAW,
+		Sample:      1,
+		Wakeup:      1,
+	}
+	attr.Size = uint32(unsafe.Sizeof(attr))
+	if disabled {
+		attr.Bits |= unix.PerfBitDisabled
+	}
+	return attr
+}
+
+func trafficPerfOpen(attr *unix.PerfEventAttr, pid int) (int, error) {
+	cpu := -1
+	if pid == -1 {
+		cpu = 0 // a pid -1 event must name a CPU; the filter is per trace event
+	}
+	return unix.PerfEventOpen(attr, pid, cpu, -1, unix.PERF_FLAG_FD_CLOEXEC)
+}
+
+// A disabled event never joins the per-CPU active list, so a hit in the
+// target does not format a sample for it; it only extends the filter.
+func (t *trafficTracefs) openEvent(id uint64, pid int) (int, error) {
+	attr := trafficPerfAttr(id, true)
+	return trafficPerfOpen(&attr, pid)
+}
+
+func (t *trafficTracefs) openCarrier(id uint64, pid int, program trafficProgram) (int, error) {
+	attr := trafficPerfAttr(id, false)
+	fd, err := trafficPerfOpen(&attr, pid)
+	if err != nil {
+		return -1, err
+	}
+	if err := unix.IoctlSetInt(fd, unix.PERF_EVENT_IOC_SET_BPF, program.FD()); err != nil {
+		unix.Close(fd)
+		return -1, fmt.Errorf("attach program: %w", err)
+	}
+	if err := unix.IoctlSetInt(fd, unix.PERF_EVENT_IOC_ENABLE, 0); err != nil {
+		unix.Close(fd)
+		return -1, fmt.Errorf("enable carrier: %w", err)
+	}
+	return fd, nil
+}
+
+func (t *trafficTracefs) closeEvent(fd int) error { return unix.Close(fd) }
+
+func (t *trafficTracefs) startTicks(pid uint32) (uint64, error) {
+	return trafficProcessStartTicks("/proc", pid)
+}
+
+// trafficProcessStartTicks reads field 22 of /proc/PID/stat, the start time
+// the collector writes into the scope file.
+func trafficProcessStartTicks(root string, pid uint32) (uint64, error) {
+	data, err := os.ReadFile(filepath.Join(root, strconv.FormatUint(uint64(pid), 10), "stat"))
+	if err != nil {
+		return 0, err
+	}
+	end := strings.LastIndexByte(string(data), ')')
+	if end < 0 {
+		return 0, errors.New("malformed process stat")
+	}
+	fields := strings.Fields(string(data)[end+1:])
+	if len(fields) < 20 {
+		return 0, errors.New("short process stat")
+	}
+	return strconv.ParseUint(fields[19], 10, 64)
+}
+
+// removeStale drops trace events left by a traffic eCapture that died without
+// closing them. Defined events without perf events install no breakpoints;
+// this only keeps tracefs tidy. The kernel refuses events still in use.
+func (t *trafficTracefs) removeStale() {
+	entries, err := os.ReadDir(filepath.Join(t.root, "events"))
+	if err != nil {
+		return
+	}
+	for _, entry := range entries {
+		owner, ok := strings.CutPrefix(entry.Name(), "traffic_")
+		if !ok || !entry.IsDir() {
+			continue
+		}
+		if pid, err := strconv.Atoi(owner); err != nil || pid <= 0 {
+			continue
+		} else if _, err := os.Stat(filepath.Join("/proc", owner)); err == nil {
+			continue
+		}
+		events, err := os.ReadDir(filepath.Join(t.root, "events", entry.Name()))
+		if err != nil {
+			continue
+		}
+		for _, event := range events {
+			if event.IsDir() && trafficTracefsIdentifier.MatchString(event.Name()) {
+				_ = t.removeEvent(entry.Name(), event.Name())
+			}
+		}
+	}
+}
