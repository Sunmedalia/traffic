+func TestTrafficPIDAttacherSetupFailureCleansUp(t *testing.T) {
+	kernel := newFakeAttachKernel()
+	kernel.carrierErr[2] = errors.New("injected SET_BPF failure")
+	program := func(string) (trafficProgram, error) { return fakeProgram(7), nil }
+	_, err := newTrafficPIDAttacher(kernel, "traffic_42", trafficTestLibrary, trafficTestProbes(), map[string]uint64{"SSL_read": 0x10}, program, 42)
+	if err == nil {
+		t.Fatal("setup failure not reported")
+	}
+	if len(kernel.events) != 0 || len(kernel.defined) != 0 {
+		t.Fatalf("left events %v, definitions %v", kernel.events, kernel.defined)
+	}
+	if _, err := newTrafficPIDAttacher(kernel, "traffic_42", trafficTestLibrary, trafficTestProbes(), map[string]uint64{}, program, 42); err == nil {
+		t.Fatal("library without any hook symbol accepted")
+	}
+	if _, err := newTrafficPIDAttacher(kernel, "traffic-42", trafficTestLibrary, trafficTestProbes(), map[string]uint64{"SSL_read": 1}, program, 42); err == nil {
+		t.Fatal("invalid tracefs group accepted")
+	}
+	if _, err := newTrafficPIDAttacher(kernel, "traffic_42", "/lib/with space/libssl.so", trafficTestProbes(), map[string]uint64{"SSL_read": 1}, program, 42); err == nil {
+		t.Fatal("library path with a space accepted")
+	}
+}
