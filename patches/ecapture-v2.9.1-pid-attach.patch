+// A process that cannot be added makes the events system-wide before any
+// per-process event closes, so no target is uncovered in between.
+func TestTrafficPIDAttacherFallsBackBeforeDroppingProcesses(t *testing.T) {
+	kernel := newFakeAttachKernel()
+	attacher := newTestAttacher(t, kernel)
+	kernel.ticks = map[uint32]uint64{10: 100, 20: 200}
+	if _, err := attacher.reconcile([]trafficScopePID{{10, 100}}); err != nil {
+		t.Fatal(err)
+	}
+	kernel.openErr[20] = syscall.EMFILE
+	before := len(kernel.log)
+	reason, err := attacher.reconcile([]trafficScopePID{{10, 100}, {20, 200}})
+	if err != nil || !strings.Contains(reason, "pid 20") {
+		t.Fatalf("reason %q, err %v", reason, err)
+	}
+	log := kernel.log[before:]
+	lastSystemOpen, firstClose := -1, len(log)
+	for i, line := range log {
+		if strings.HasSuffix(line, "pid -1") && strings.HasPrefix(line, "open") {
+			lastSystemOpen = i
+		}
+		if strings.HasPrefix(line, "close") && i < firstClose {
+			firstClose = i
+		}
+	}
+	if lastSystemOpen < 0 || lastSystemOpen > firstClose {
+		t.Fatalf("system-wide events must open before per-process events close: %v", log)
+	}
+	if got := kernel.filterPIDs(); len(got) != 1 || got[-1] != 2 {
+		t.Fatalf("after fallback %v", got)
+	}
+	// Later scopes no longer touch per-process events.
+	if reason, err := attacher.reconcile([]trafficScopePID{{10, 100}}); err != nil || reason != "" || kernel.filterPIDs()[10] != 0 {
+		t.Fatal("reconcile after fallback reattached a process")
+	}
+	attacher.close()
+	if len(kernel.events) != 0 || len(kernel.defined) != 0 {
+		t.Fatalf("left events %v, definitions %v", kernel.events, kernel.defined)
+	}
+}
+
+// If even the system-wide events fail, the per-process events stay and the
+// caller gets an error (it then clears the scope and the collector restarts).
+func TestTrafficPIDAttacherFailedFallbackKeepsProcesses(t *testing.T) {
+	kernel := newFakeAttachKernel()
+	attacher := newTestAttacher(t, kernel)
+	kernel.ticks = map[uint32]uint64{10: 100, 20: 200}
+	if _, err := attacher.reconcile([]trafficScopePID{{10, 100}}); err != nil {
+		t.Fatal(err)
+	}
+	kernel.openErr[20] = syscall.EMFILE
+	kernel.openErr[-1] = syscall.EMFILE
+	if _, err := attacher.reconcile([]trafficScopePID{{10, 100}, {20, 200}}); err == nil {
+		t.Fatal("failed fallback not reported")
+	}
+	if got := kernel.filterPIDs(); len(got) != 1 || got[10] != 2 {
+		t.Fatalf("process events changed: %v", got)
+	}
+	delete(kernel.openErr, 20)
+	if reason, err := attacher.reconcile([]trafficScopePID{{10, 100}, {20, 200}}); err != nil || reason != "" || kernel.filterPIDs()[20] != 2 {
+		t.Fatalf("retry: %q %v %v", reason, err, kernel.filterPIDs())
+	}
+	attacher.close()
+}
