+// Drain stops accepting new clients, closes active client send queues after
+// already-enqueued messages, and waits until connected clients finish flushing
+// their queues or ctx expires.
+func (s *Server) Drain(ctx context.Context) error {
+	s.clientsMu.Lock()
+	s.closing = true
