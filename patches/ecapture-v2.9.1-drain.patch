index 0000000..5689775
--- /dev/null
+++ b/internal/probe/base/traffic_drain_test.go
@@ -0,0 +1,136 @@
+package base
+
+import (
+	"io"
+	"os"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+// fakeDeadlineReader mirrors cilium/ebpf perf.Reader and ringbuf.Reader locking:
+// Read holds mu while waiting for either deadline expiry or Close(), and
+// SetDeadline also acquires mu (so calling SetDeadline from another goroutine
+// while Read is blocked would deadlock).
+type fakeDeadlineReader struct {
+	mu                sync.Mutex
+	deadline          time.Time
+	items             int
+	closedCh          chan struct{}
+	closeOnce         sync.Once
+	closedBeforeDrain atomic.Bool
+	drained           atomic.Bool
+}
+
+func newFakeDeadlineReader(items int) *fakeDeadlineReader {
+	return &fakeDeadlineReader{
+		items:    items,
+		closedCh: make(chan struct{}),
+	}
+}
+
+func (r *fakeDeadlineReader) SetDeadline(t time.Time) {
+	r.mu.Lock()
+	r.deadline = t
+	r.mu.Unlock()
+}
+
+func (r *fakeDeadlineReader) Read() (bool, error) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.items > 0 {
+		r.items--
+		return true, nil
+	}
+	if r.deadline.IsZero() {
+		<-r.closedCh
+		return false, io.EOF
+	}
+	wait := time.Until(r.deadline)
+	if wait <= 0 {
+		return false, os.ErrDeadlineExceeded
+	}
+	timer := time.NewTimer(wait)
+	defer timer.Stop()
+	select {
+	case <-r.closedCh:
+		return false, io.EOF
+	case <-timer.C:
+		return false, os.ErrDeadlineExceeded
+	}
+}
+
+func (r *fakeDeadlineReader) Close() error {
+	r.closeOnce.Do(func() {
+		if !r.drained.Load() {
+			r.closedBeforeDrain.Store(true)
+		}
+		close(r.closedCh)
+	})
+	return nil
+}
+
+func TestDrainDeadlineReadersWaitsForBufferedItemsWithoutCrossGoroutineSetDeadline(t *testing.T) {
+	reader := newFakeDeadlineReader(5)
+	var draining atomic.Bool
+	var wg sync.WaitGroup
+	wg.Add(1)
+	var dispatched atomic.Int32
+	enteredIdleWait := make(chan struct{}, 1)
+	go func() {
+		defer wg.Done()
+		for {
+			if draining.Load() {
+				reader.SetDeadline(time.Unix(0, 1))
+			} else {
+				reader.SetDeadline(time.Now().Add(25 * time.Millisecond))
+			}
+			if reader.items == 0 && !draining.Load() {
+				select {
+				case enteredIdleWait <- struct{}{}:
+				default:
+				}
+			}
+			ok, err := reader.Read()
+			if err != nil {
+				if err == os.ErrDeadlineExceeded {
+					if draining.Load() {
+						reader.drained.Store(true)
+						return
+					}
+					continue
+				}
+				return
+			}
+			if ok {
+				dispatched.Add(1)
+			}
+		}
+	}()
+
+	<-enteredIdleWait
+	draining.Store(true)
+	drained, errs := drainDeadlineReaders([]io.Closer{reader}, wg.Wait, time.Second)
+	if !drained || len(errs) != 0 {
+		t.Fatalf("drained=%v errs=%v", drained, errs)
+	}
+	if dispatched.Load() != 5 || reader.closedBeforeDrain.Load() {
+		t.Fatalf("dispatched=%d closedBeforeDrain=%v", dispatched.Load(), reader.closedBeforeDrain.Load())
+	}
+}
+
+func TestDrainDeadlineReadersForcesCloseAfterBudget(t *testing.T) {
+	reader := newFakeDeadlineReader(0)
+	var wg sync.WaitGroup
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		_, _ = reader.Read()
+	}()
+
+	drained, errs := drainDeadlineReaders([]io.Closer{reader}, wg.Wait, 25*time.Millisecond)
+	if drained || len(errs) != 0 {
+		t.Fatalf("expected timeout (drained=false), got drained=%v errs=%v", drained, errs)
+	}
+}
