+	pb "github.com/gojue/ecapture/v2/protobuf/gen/v1"
+)
+
+func TestServerDrainFlushesQueuedEventsAndFinalControlOverWebSocket(t *testing.T) {
+	server := NewServer("127.0.0.1:0", io.Discard)
+	t.Cleanup(func() { _ = server.Close() })
+	errCh, err := server.StartAsync()
+	if err != nil {
+		t.Fatal(err)
+	}
+	server.httpMu.Lock()
+	addr := server.listener.Addr().String()
+	server.httpMu.Unlock()
+
+	ws, err := websocket.Dial("ws://"+addr+"/", "", "http://"+addr)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ws.Close()
+
+	// Receive the initial heartbeat so we know registration completed.
+	var first []byte
+	if err := websocket.Message.Receive(ws, &first); err != nil {
+		t.Fatal(err)
+	}
+	if decodeEntry(t, first).GetLogType() != pb.LogType_LOG_TYPE_HEARTBEAT {
+		t.Fatalf("expected initial heartbeat, got %v", decodeEntry(t, first).GetLogType())
+	}
+
+	const total = 64
+	for seq := uint64(1); seq <= total; seq++ {
+		if err := server.PublishEvent(context.Background(), domain.CapturedEventEnvelope{
+			Format:   domain.CaptureFormatText,
+			Payload:  []byte(fmt.Sprintf("payload-%d", seq)),
+			Sequence: seq,
+		}); err != nil {
+			t.Fatalf("publish %d: %v", seq, err)
+		}
+	}
+	if got := server.LastSequence(); got != total {
+		t.Fatalf("LastSequence() = %d, want %d", got, total)
+	}
+	finalControl := fmt.Sprintf("traffic-control-v1:drained:seq=%d,dropped=%d,perf_lost=0", server.LastSequence(), server.DroppedMessages())
+	if err := server.PublishLog(context.Background(), domain.OperationalLogRecord{Message: finalControl}); err != nil {
+		t.Fatal(err)
+	}
+
+	drainDone := make(chan error, 1)
+	go func() {
+		ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+		defer cancel()
+		drainDone <- server.Drain(ctx)
+	}()
+
+	var seenSeq uint64
+	sawDrained := false
+	for {
+		var raw []byte
+		err := websocket.Message.Receive(ws, &raw)
+		if errors.Is(err, io.EOF) {
+			break
+		}
+		if err != nil {
+			t.Fatalf("receive during drain: %v", err)
+		}
+		entry := decodeEntry(t, raw)
+		switch entry.GetLogType() {
+		case pb.LogType_LOG_TYPE_EVENT:
+			if sawDrained {
+				t.Fatal("received event after drained control record")
+			}
+			seenSeq++
+			if entry.GetEventPayload().GetSequence() != seenSeq {
+				t.Fatalf("sequence = %d, want %d", entry.GetEventPayload().GetSequence(), seenSeq)
+			}
+		case pb.LogType_LOG_TYPE_PROCESS_LOG:
+			if entry.GetRunLog() == finalControl {
+				sawDrained = true
+			}
+		}
+	}
+
+	if err := <-drainDone; err != nil {
+		t.Fatalf("Drain() error = %v", err)
+	}
+	if seenSeq != total || !sawDrained {
+		t.Fatalf("seenSeq=%d (want %d) sawDrained=%v", seenSeq, total, sawDrained)
+	}
+	if server.hub.queuedBytes.Load() != 0 {
+		t.Fatalf("queuedBytes = %d, want 0", server.hub.queuedBytes.Load())
+	}
+	if err := server.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := <-errCh; err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestServerDrainTimeoutReleasesReservationsOnClose(t *testing.T) {
+	server := NewServer("127.0.0.1:0", io.Discard)
+	errCh, err := server.StartAsync()
+	if err != nil {
+		t.Fatal(err)
+	}
+	server.httpMu.Lock()
+	addr := server.listener.Addr().String()
+	server.httpMu.Unlock()
+
+	ws, err := websocket.Dial("ws://"+addr+"/", "", "http://"+addr)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ws.Close()
+
+	var first []byte
+	if err := websocket.Message.Receive(ws, &first); err != nil {
+		t.Fatal(err)
+	}
+
+	// Fill enough large payloads without reading from ws so writePump blocks in socket write.
+	chunk := make([]byte, 256<<10)
+	for seq := uint64(1); seq <= 24; seq++ {
+		if err := server.PublishEvent(context.Background(), domain.CapturedEventEnvelope{
+			Format:   domain.CaptureFormatText,
+			Payload:  chunk,
+			Sequence: seq,
+		}); err != nil {
+			t.Fatalf("publish %d: %v", seq, err)
+		}
+	}
+
+	ctx, cancel := context.WithTimeout(context.Background(), 40*time.Millisecond)
+	defer cancel()
+	err = server.Drain(ctx)
+	if !errors.Is(err, context.DeadlineExceeded) {
+		// On machines with very large socket buffers Drain may finish immediately;
+		// either nil or DeadlineExceeded is valid, and Close must always release all bytes.
+		if err != nil {
+			t.Fatalf("unexpected Drain() error: %v", err)
+		}
+	}
+	if err := server.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if server.hub.queuedBytes.Load() != 0 {
+		t.Fatalf("leaked queuedBytes after Close: %d", server.hub.queuedBytes.Load())
+	}
+	<-errCh
+}
