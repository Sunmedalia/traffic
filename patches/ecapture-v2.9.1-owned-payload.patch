+func TestCompactPayloadOwnsInputAndClone(t *testing.T) {
+	wire := compactEventBytes(t, []byte("secret"), 6)
+	event := &Event{}
+	if err := event.DecodeFromBytes(wire); err != nil {
+		t.Fatal(err)
+	}
+	wire[176] = 'X'
+	if string(event.GetData()) != "secret" {
+		t.Fatal("perf buffer reuse changed event payload")
+	}
+	cloned := event.Clone().(*Event)
+	event.Data[0] = 'Y'
+	if string(cloned.GetData()) != "secret" {
+		t.Fatal("clone shares mutable payload")
+	}
+	if err := event.DecodeFromBytes(compactEventBytes(t, []byte("x"), 1)); err != nil {
+		t.Fatal(err)
+	}
+	if len(event.Data) != 1 || cap(event.Data) != 1 {
+		t.Fatal("short payload retained a larger allocation")
+	}
+	if err := event.DecodeFromBytes([]byte{1, 2}); err == nil {
+		t.Fatal("malformed event accepted")
+	}
+	if len(event.Data) != 0 {
+		t.Fatal("failed decode retained previous payload")
+	}
+}
