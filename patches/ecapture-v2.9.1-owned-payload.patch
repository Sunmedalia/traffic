new file mode 100644
--- /dev/null
+++ b/internal/probe/openssl/traffic_payload_benchmark_test.go
@@ -0,0 +1,36 @@
+package openssl
+
+import (
+	"bytes"
+	"encoding/binary"
+	"fmt"
+	"testing"
+)
+
+func BenchmarkCompactEventOwnedPayload(b *testing.B) {
+	for _, size := range []int{0, 128, 1024, MaxDataSize} {
+		b.Run(fmt.Sprint(size), func(b *testing.B) {
+			var buffer bytes.Buffer
+			fields := []any{uint64(0x5452414643544c32), int64(DataTypeRead), uint64(12345), uint32(42), uint32(43), int32(size), [16]byte{}, uint32(7), int32(Tls13Version), uint32(0), uint64(0x54524146434f4e31), connDataEvent{Pid: 42, Fd: 7, Family: 2, Sport: 12345, Dport: 443, Inode: 987}}
+			for _, field := range fields {
+				if err := binary.Write(&buffer, binary.LittleEndian, field); err != nil {
+					b.Fatal(err)
+				}
+			}
+			buffer.Write(bytes.Repeat([]byte("x"), size))
+			wire := buffer.Bytes()
+			decoder := &tlsEventDecoder{}
+			b.ReportAllocs()
+			b.ResetTimer()
+			for i := 0; i < b.N; i++ {
+				event, err := decoder.Decode(nil, wire)
+				if err != nil {
+					b.Fatal(err)
+				}
+				if len(event.(*Event).GetData()) != size {
+					b.Fatal("payload mismatch")
+				}
+			}
+		})
+	}
+}
diff --git a/pkg/ecaptureq/owned_payload_test.go b/pkg/ecaptureq/owned_payload_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/ecaptureq/owned_payload_test.go
@@ -0,0 +1,36 @@
+package ecaptureq
+
+import (
+	"bytes"
+	"context"
+	"io"
+	"testing"
+
+	"github.com/gojue/ecapture/v2/internal/domain"
+)
+
+func TestPublishBuffersRemainStableAfterCallerMutation(t *testing.T) {
+	server := NewServer("127.0.0.1:0", io.Discard)
+	defer server.Close()
+	client := newQueueClient(server, 8)
+	if err := server.hub.registerClient(context.Background(), client); err != nil {
+		t.Fatal(err)
+	}
+	payload := []byte("owned protobuf payload")
+	if err := server.PublishEvent(context.Background(), domain.CapturedEventEnvelope{Payload: payload}); err != nil {
+		t.Fatal(err)
+	}
+	payload[0] = 'X'
+	entry := decodeEntry(t, receiveQueueMessage(client))
+	if string(entry.GetEventPayload().GetPayload()) != "owned protobuf payload" {
+		t.Fatal("wire event aliases caller payload")
+	}
+	borrowed := []byte("borrowed hub buffer")
+	if err := server.hub.publish(context.Background(), borrowed, false); err != nil {
+		t.Fatal(err)
+	}
+	borrowed[0] = 'X'
+	if !bytes.Equal(receiveQueueMessage(client), []byte("borrowed hub buffer")) {
+		t.Fatal("generic publish lost snapshot ownership")
+	}
+}
