diff --git a/internal/probe/openssl/event_test.go b/internal/probe/openssl/event_test.go
--- a/internal/probe/openssl/event_test.go
+++ b/internal/probe/openssl/event_test.go
@@ -361,3 +361,59 @@
 		})
 	}
 }
+
+func compactEventBytes(t *testing.T, payload []byte, length int32) []byte {
+	t.Helper()
+	b := new(bytes.Buffer)
+	// Match the compact C header: data begins at offset 176.
+	fields := []any{uint64(0x5452414643544c32), int64(DataTypeRead), uint64(12345), uint32(42), uint32(43), length, [16]byte{}, uint32(7), int32(Tls13Version), uint32(0), uint64(0x54524146434f4e31), connDataEvent{Pid: 42, Fd: 7, Family: 2, Sport: 12345, Dport: 443, Inode: 987}}
+	for _, f := range fields {
+		if err := binary.Write(b, binary.LittleEndian, f); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if b.Len() != 176 {
+		t.Fatal("compact C/Go header offset mismatch", b.Len())
+	}
+	b.Write(payload)
+	return b.Bytes()
+}
+
+func TestCompactEventLengthsAndPadding(t *testing.T) {
+	for _, n := range []int{0, 1, 1024, MaxDataSize} {
+		payload := bytes.Repeat([]byte{0x41}, n)
+		wire := compactEventBytes(t, payload, int32(n))
+		wire = append(wire, 0, 0, 0, 0) // perf samples can carry alignment padding
+		e := &Event{}
+		if err := e.DecodeFromBytes(wire); err != nil {
+			t.Fatal(n, err)
+		}
+		if e.DataLen != int32(n) || !bytes.Equal(e.Data[:n], payload) || e.Pid != 42 || e.Timestamp != 12345 || e.connectionID != "42_inode_987" {
+			t.Fatal("compact event changed fields", n, e.DataLen, e.connectionID)
+		}
+	}
+}
+
+func TestCompactEventRejectsTruncationAndInvalidLength(t *testing.T) {
+	wire := compactEventBytes(t, []byte("payload"), 7)
+	for _, cut := range []int{8, 24, 36, 72, 175, 176, len(wire) - 1} {
+		if err := (&Event{}).DecodeFromBytes(wire[:cut]); err == nil {
+			t.Fatal("truncated compact event accepted", cut)
+		}
+	}
+	for _, n := range []int32{-1, MaxDataSize + 1} {
+		if err := (&Event{}).DecodeFromBytes(compactEventBytes(t, nil, n)); err == nil {
+			t.Fatal("invalid compact payload length accepted", n)
+		}
+	}
+	e := &Event{}
+	if err := e.DecodeFromBytes(compactEventBytes(t, []byte("secret"), 6)); err != nil {
+		t.Fatal(err)
+	}
+	if err := e.DecodeFromBytes(compactEventBytes(t, []byte("x"), 1)); err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(e.Data[1:6], make([]byte, 5)) {
+		t.Fatal("reused event retained stale plaintext beyond its payload")
+	}
+}
