--- /dev/null
+++ b/internal/probe/base/traffic_reorder_benchmark_test.go
@@ -0,0 +1,18 @@
+package base
+
+import "testing"
+
+func BenchmarkPerfReorderSteadyLag(b *testing.B) {
+	r := newPerfLagReorder(100_000_000)
+	flushed := 0
+	b.ReportAllocs()
+	b.ResetTimer()
+	for i := 0; i < b.N; i++ {
+		flushed += len(r.push(ev(uint64(i)*200_000, 'x')))
+	}
+	b.StopTimer()
+	flushed += len(r.flushAll())
+	if flushed != b.N {
+		b.Fatal("reorder lost events", flushed, b.N)
+	}
+}
