diff --git a/docs/agent/probe-development.md b/docs/agent/probe-development.md
--- a/docs/agent/probe-development.md
+++ b/docs/agent/probe-development.md
@@ -268,3 +268,10 @@
 Validate rejects a length beyond that slice. Compact decode copies exactly its
 validated length, and legacy decode still consumes the fixed 16 KiB body before
 its trailing header. Clone preserves independent payload ownership.
+
+Perf timestamp reordering uses a typed min-heap keyed by monotonic timestamp
+and arrival order. Push/pop is logarithmic in the pending window, equal-time
+events remain stable, and pressure still flushes the oldest half at maxPending.
+Idle/shutdown flushes release every event reference; no pending window is copied
+on each input. Tests compare pressure, lag and idle behavior against a stable
+sorting reference.
diff --git a/internal/probe/base/traffic_reorder_test.go b/internal/probe/base/traffic_reorder_test.go
new file mode 100644
--- /dev/null
+++ b/internal/probe/base/traffic_reorder_test.go
@@ -0,0 +1,88 @@
+package base
+
+import (
+	"math/rand"
+	"sort"
+	"testing"
+
+	"github.com/gojue/ecapture/v2/internal/domain"
+)
+
+// Keep a sorting/partition reference independent of the heap implementation.
+type sortingReorder struct {
+	lag   uint64
+	limit int
+	buf   []perfReorderItem
+}
+
+func (r *sortingReorder) ordered(n int) []domain.Event {
+	sort.SliceStable(r.buf, func(i, j int) bool { return r.buf[i].mono < r.buf[j].mono })
+	out := make([]domain.Event, n)
+	for i := range out {
+		out[i] = r.buf[i].ev
+	}
+	r.buf = append([]perfReorderItem(nil), r.buf[n:]...)
+	return out
+}
+func (r *sortingReorder) push(event domain.MonoNsEvent) []domain.Event {
+	r.buf = append(r.buf, perfReorderItem{ev: event, mono: event.PerfMonoNs()})
+	if len(r.buf) >= r.limit {
+		return r.ordered(max(1, len(r.buf)/2))
+	}
+	if len(r.buf) <= 1 {
+		return nil
+	}
+	lo, hi := r.buf[0].mono, r.buf[0].mono
+	for _, item := range r.buf {
+		lo = min(lo, item.mono)
+		hi = max(hi, item.mono)
+	}
+	if hi-lo < r.lag {
+		return nil
+	}
+	cutoff := hi - r.lag
+	count := 0
+	for _, item := range r.buf {
+		if item.mono <= cutoff {
+			count++
+		}
+	}
+	return r.ordered(count)
+}
+func TestHeapReorderMatchesStableSortAcrossPressureAndIdle(t *testing.T) {
+	for _, lag := range []uint64{0, 1, 100, 10000} {
+		for _, limit := range []int{1, 2, 3, 17, 1024} {
+			heap := newPerfLagReorder(lag)
+			heap.maxPending = limit
+			reference := &sortingReorder{lag: lag, limit: limit}
+			rng := rand.New(rand.NewSource(19))
+			seen := map[domain.Event]bool{}
+			compare := func(actual, expected []domain.Event) {
+				t.Helper()
+				if len(actual) != len(expected) {
+					t.Fatalf("lag=%d limit=%d count %d != %d", lag, limit, len(actual), len(expected))
+				}
+				for i, event := range actual {
+					if event != expected[i] || seen[event] {
+						t.Fatalf("lag=%d limit=%d changed order or duplicated an event", lag, limit)
+					}
+					seen[event] = true
+				}
+			}
+			for i := 0; i < 4096; i++ {
+				event := ev(uint64(rng.Intn(2000)), byte(i))
+				compare(heap.push(event), reference.push(event))
+				if i%1321 == 0 {
+					compare(heap.flushAll(), reference.ordered(len(reference.buf)))
+				}
+				if len(heap.buf) >= limit {
+					t.Fatal("pending bound exceeded")
+				}
+			}
+			compare(heap.flushAll(), reference.ordered(len(reference.buf)))
+			if len(seen) != 4096 {
+				t.Fatal("missing events", len(seen))
+			}
+		}
+	}
+}
diff --git a/internal/probe/base/traffic_reorder_benchmark_test.go b/internal/probe/base/traffic_reorder_benchmark_test.go
