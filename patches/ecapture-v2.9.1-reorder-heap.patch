+// pop releases the oldest item and clears its retained event reference. The
+// typed heap avoids boxing allocations and copying the whole remaining window.
+func (r *perfLagReorder) pop() domain.Event {
+	event := r.buf[0].ev
+	last := len(r.buf) - 1
+	r.buf[0] = r.buf[last]
+	r.buf[last] = perfReorderItem{}
+	r.buf = r.buf[:last]
+	for parent := 0; parent < len(r.buf)/2; {
+		child := 2*parent + 1
+		if child+1 < len(r.buf) && r.less(child+1, child) {
+			child++
+		}
+		if !r.less(child, parent) {
+			break
+		}
+		r.buf[parent], r.buf[child] = r.buf[child], r.buf[parent]
+		parent = child
+	}
+	if len(r.buf) == 0 {
+		r.maxNs = 0
+		r.nextArrival = 0
+	}
+	return event
